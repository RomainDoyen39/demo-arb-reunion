---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Base title="Annuaire des acteurs — ARB Réunion">
  <Header current="annuaire" />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]"><div class="flex flex-col w-full">
<!-- 1. HERO SECTION -->
<section class="page-hero hero-photo relative overflow-hidden pt-8 pb-24 lg:pt-14 lg:pb-32" style="--hero-image: url('/images/bandeaux/mafate.webp')">
<div class="max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin relative z-10">
<!-- Breadcrumb & Sur-titre -->
<div class="flex items-center gap-space-xs mb-space-sm">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container/60 text-primary-container font-label-sm text-label-sm uppercase tracking-widest">
<span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
          RÉSEAU PROFESSIONNEL &amp; TERRITORIAL PÉI
        </span>
</div>
<!-- Titre & Châpo -->
<div class="max-w-4xl">
<h1 class="font-display-lg text-headline-lg md:text-display-lg text-primary leading-tight mb-space-md">
          Annuaire des Acteurs de la Biodiversité à La Réunion
        </h1>
<p class="font-body-lg text-body-lg text-secondary max-w-3xl leading-relaxed">
          Cartographiez, identifiez et collaborez avec plus de 240 structures engagées dans la préservation, la restauration et la valorisation des écosystèmes terrestres, marins et d'eau douce de l'île.
        </p>
</div>
<!-- Main Search Console -->
<div class="mt-space-lg bg-surface-container-lowest rounded-lg p-space-sm md:p-space-md shadow-xl border-none">
<form class="grid grid-cols-1 lg:grid-cols-12 gap-space-sm items-center" id="annuaire-search">
<!-- Text Input with Autocomplete mock -->
<div class="lg:col-span-5 relative">
<label class="block font-label-sm text-label-sm text-secondary mb-1">Mot-clé, organisme ou compétence</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-secondary text-[22px]">search</span>
<input class="w-full pl-10 pr-4 py-2.5 rounded-full bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all placeholder:text-outline" id="search-input" placeholder="Ex : Kélonia, CBNM, génie végétal, Saint-Paul..." type="text">
</div>
  </div>
<!-- Select: Typologie d'acteur -->
<div class="lg:col-span-3">
<label class="block font-label-sm text-label-sm text-secondary mb-1">Typologie d'acteur</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">account_balance</span>
<select class="w-full pl-9 pr-8 py-2.5 rounded-full bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all appearance-none cursor-pointer" id="filter-type">
<option value="">Toutes les typologies</option>
<option value="public">Collectivités &amp; Établissements publics</option>
<option value="gest">Gestionnaires d'espaces naturels &amp; Parcs</option>
<option value="recherche">Laboratoires &amp; Recherche scientifique</option>
<option value="asso">Associations &amp; ONG péi</option>
<option value="bureau">Bureaux d'études &amp; Génie écologique</option>
<option value="pepiniere">Pépinières agréées Végétal Péi</option>
        </select>
<span class="material-symbols-outlined absolute right-3 pointer-events-none text-secondary text-[18px]">expand_more</span>
</div>
</div>
<!-- Select: Micro-région -->
<div class="lg:col-span-2">
<label class="block font-label-sm text-label-sm text-secondary mb-1">Micro-région</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">explore</span>
<select class="w-full pl-9 pr-8 py-2.5 rounded-full bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all appearance-none cursor-pointer" id="filter-region">
<option value="">Toute l'île</option>
<option value="ouest">Micro-région Ouest</option>
<option value="nord">Micro-région Nord</option>
<option value="sud">Micro-région Sud</option>
<option value="est">Micro-région Est</option>
<option value="hauts">Cirques &amp; Hauts</option>
        </select>
<span class="material-symbols-outlined absolute right-3 pointer-events-none text-secondary text-[18px]">expand_more</span>
</div>
</div>
<!-- Submit Button -->
<div class="lg:col-span-2 self-end pt-2 lg:pt-0">
<button class="box-border h-[46px] w-full flex items-center justify-center gap-2 px-space-md rounded-full bg-primary-container text-inverse-on-surface font-label-lg text-label-lg hover:bg-primary transition-all shadow-md group" type="submit">
<span>Filtrer</span>
<span class="material-symbols-outlined text-[18px] group-hover:translate-x-0.5 transition-transform">tune</span>
</button>
</div>
    </form>
</div>
<!-- Quick Metrics Counters -->
<div class="mt-space-lg grid grid-cols-2 md:grid-cols-4 gap-space-sm">
<div class="bg-white rounded-2xl px-4 py-3.5 flex items-center gap-3 shadow-sm">
<div class="w-11 h-11 shrink-0 rounded-full bg-secondary-container flex items-center justify-center text-primary-container">
<span class="material-symbols-outlined text-[22px]">domain</span>
</div>
<div class="min-w-0">
<div class="font-headline-md text-headline-md font-bold text-primary-container leading-none">248</div>
<div class="mt-1 font-label-md text-label-md text-on-surface leading-tight">structures référencées</div>
</div>
</div>
<div class="bg-white rounded-2xl px-4 py-3.5 flex items-center gap-3 shadow-sm">
<div class="w-11 h-11 shrink-0 rounded-full bg-secondary-container flex items-center justify-center text-primary-container">
<span class="material-symbols-outlined text-[22px]">hub</span>
</div>
<div class="min-w-0">
<div class="font-headline-md text-headline-md font-bold text-primary-container leading-none">4 pôles</div>
<div class="mt-1 font-label-md text-label-md text-on-surface leading-tight">d'action majeurs</div>
</div>
</div>
<div class="bg-white rounded-2xl px-4 py-3.5 flex items-center gap-3 shadow-sm">
<div class="w-11 h-11 shrink-0 rounded-full bg-secondary-container flex items-center justify-center text-primary-container">
<span class="material-symbols-outlined text-[22px]">location_city</span>
</div>
<div class="min-w-0">
<div class="font-headline-md text-headline-md font-bold text-primary-container leading-none">24 / 24</div>
<div class="mt-1 font-label-md text-label-md text-on-surface leading-tight">communes couvertes</div>
</div>
</div>
<div class="bg-white rounded-2xl px-4 py-3.5 flex items-center gap-3 shadow-sm">
<div class="w-11 h-11 shrink-0 rounded-full bg-secondary-container flex items-center justify-center text-primary-container">
<span class="material-symbols-outlined text-[22px]">verified</span>
</div>
<div class="min-w-0">
<div class="font-headline-md text-headline-md font-bold text-primary-container leading-none">100%</div>
<div class="mt-1 font-label-md text-label-md text-on-surface leading-tight">expertises certifiées ARB</div>
</div>
</div>
</div>
</div>
<div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none">
<svg class="w-full h-12 md:h-20 text-surface-container fill-current block" preserveAspectRatio="none" viewBox="0 -16 1440 112">
<path d="M0,32 C280,96 520,0 840,48 C1160,96 1360,16 1440,32 L1440,96 L0,96 Z"></path>
</svg>
</div>
</section>
<!-- 2. CARTOGRAPHIE & EXPLORATION GÉOGRAPHIQUE -->
<section class="bg-surface-container py-space-xl -mt-px">
<div class="max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<!-- Section Header with Switch Buttons -->
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-lg">
<div>
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest block mb-1">RÉPARTITION GÉOGRAPHIQUE</span>
<h2 class="font-headline-lg text-headline-md md:text-headline-lg text-primary">
            Implantation insulaire des structures partenaires
          </h2>
</div>
<!-- Toggle Switcher -->
<div class="inline-flex p-1 rounded-full bg-surface-container-high self-start md:self-auto">
<button type="button" class="px-space-md py-1.5 rounded-full font-label-md text-label-md bg-surface text-primary-container shadow-sm flex items-center gap-1.5 transition-all" id="btn-toggle-map" aria-pressed="true">
<span class="material-symbols-outlined text-[18px]">map</span>
<span>Vue Carte Stylisée</span>
</button>
<button type="button" class="px-space-md py-1.5 rounded-full font-label-md text-label-md text-secondary hover:text-primary-container flex items-center gap-1.5 transition-all" id="btn-toggle-list" aria-pressed="false">
<span class="material-symbols-outlined text-[18px]">view_list</span>
<span>Vue Synthèse</span>
</button>
</div>
</div>
<!-- Two-column interactive console -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-stretch" id="annuaire-console">
<!-- Left: real map of Réunion -->
<div class="lg:col-span-8 bg-surface-container-lowest rounded-lg p-space-md md:p-space-lg shadow-sm relative" id="map-view">
<div class="flex flex-wrap items-center gap-2 mb-4" id="map-legend">
<span class="font-label-sm text-label-sm text-secondary">Légende :</span>
<button type="button" data-type="public" class="inline-flex items-center gap-1.5 text-xs text-on-surface px-2.5 py-1 rounded-full hover:bg-surface-container transition-colors">
<span class="w-3 h-3 rounded-full bg-primary-container"></span> Institutions
</button>
<button type="button" data-type="gest" class="inline-flex items-center gap-1.5 text-xs text-on-surface px-2.5 py-1 rounded-full hover:bg-surface-container transition-colors">
<span class="w-3 h-3 rounded-full bg-[#1e6f5c]"></span> Parcs &amp; Réserves
</button>
<button type="button" data-type="recherche" class="inline-flex items-center gap-1.5 text-xs text-on-surface px-2.5 py-1 rounded-full hover:bg-surface-container transition-colors">
<span class="w-3 h-3 rounded-full bg-[#2f5d8c]"></span> Recherche
</button>
<button type="button" data-type="bureau" class="inline-flex items-center gap-1.5 text-xs text-on-surface px-2.5 py-1 rounded-full hover:bg-surface-container transition-colors">
<span class="w-3 h-3 rounded-full bg-[#c07d32]"></span> Bureaux &amp; Experts
</button>
<button type="button" data-type="asso" class="inline-flex items-center gap-1.5 text-xs text-on-surface px-2.5 py-1 rounded-full hover:bg-surface-container transition-colors">
<span class="w-3 h-3 rounded-full bg-[#c84b31]"></span> Associations péi
</button>
</div>
<div class="relative z-0 w-full h-80 md:h-[28rem] rounded-lg overflow-hidden bg-[#d7e4df]" id="reunion-map" role="region" aria-label="Carte de La Réunion"></div>
<p class="hidden mt-3 text-sm text-secondary" id="map-empty">Aucune structure ne correspond à ces filtres sur la carte.</p>
<p class="mt-3 text-xs text-secondary flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-primary-container">info</span>
Cliquez sur un repère pour ouvrir la fiche. La légende filtre les structures.
</p>
</div>
<div class="lg:col-span-8 bg-surface-container-lowest rounded-lg p-space-md md:p-space-lg shadow-sm" id="synthese-view" hidden>
<h3 class="font-headline-sm text-headline-sm text-primary mb-1">Synthèse des structures</h3>
<p class="font-body-sm text-body-sm text-secondary mb-space-sm" id="synthese-count"></p>
<div class="divide-y divide-surface-container" id="synthese-list"></div>
<p class="hidden text-sm text-secondary" id="synthese-empty">Aucune structure ne correspond à ces filtres.</p>
</div>
<!-- Right: Territorial Breakdown Card List -->
<div class="lg:col-span-4 flex flex-col justify-start gap-space-sm">
<div class="bg-surface-container-lowest rounded-lg p-space-md shadow-sm">
<h3 class="font-headline-sm text-headline-sm text-primary mb-space-sm flex items-center justify-between">
<span>Pôles Territoriaux</span>
<span class="font-label-sm text-label-sm text-secondary bg-surface-container px-2 py-0.5 rounded-full">5 zones</span>
</h3>
<p class="font-body-sm text-body-sm text-secondary mb-space-md">
              Les structures se répartissent sur l'ensemble des bassins versants insulaires, du lagon aux plus hauts pitons.
            </p>
<ul class="space-y-space-sm" id="region-list">
<li data-region="ouest" tabindex="0" role="button" aria-pressed="false" class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low hover:bg-secondary-container/40 transition-colors cursor-pointer group">
<div class="flex items-center gap-2.5">
<span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
<span class="font-label-lg text-label-lg text-on-surface group-hover:text-primary-container">Micro-région Ouest</span>
</div>
<span class="font-label-md text-label-md bg-surface-container px-2.5 py-0.5 rounded-full text-primary-container font-semibold">78 acteurs</span>
</li>
<li data-region="nord" tabindex="0" role="button" aria-pressed="false" class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low hover:bg-secondary-container/40 transition-colors cursor-pointer group">
<div class="flex items-center gap-2.5">
<span class="w-2.5 h-2.5 rounded-full bg-primary-container"></span>
<span class="font-label-lg text-label-lg text-on-surface group-hover:text-primary-container">Micro-région Nord</span>
</div>
<span class="font-label-md text-label-md bg-surface-container px-2.5 py-0.5 rounded-full text-primary-container font-semibold">64 acteurs</span>
</li>
<li data-region="sud" tabindex="0" role="button" aria-pressed="false" class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low hover:bg-secondary-container/40 transition-colors cursor-pointer group">
<div class="flex items-center gap-2.5">
<span class="w-2.5 h-2.5 rounded-full bg-[#c07d32]"></span>
<span class="font-label-lg text-label-lg text-on-surface group-hover:text-primary-container">Micro-région Sud</span>
</div>
<span class="font-label-md text-label-md bg-surface-container px-2.5 py-0.5 rounded-full text-primary-container font-semibold">52 acteurs</span>
</li>
<li data-region="est hauts" tabindex="0" role="button" aria-pressed="false" class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low hover:bg-secondary-container/40 transition-colors cursor-pointer group">
<div class="flex items-center gap-2.5">
<span class="w-2.5 h-2.5 rounded-full bg-[#1e6f5c]"></span>
<span class="font-label-lg text-label-lg text-on-surface group-hover:text-primary-container">Est, Cirques &amp; Hauts</span>
</div>
<span class="font-label-md text-label-md bg-surface-container px-2.5 py-0.5 rounded-full text-primary-container font-semibold">34 acteurs</span>
</li>
<li data-region="soi" tabindex="0" role="button" aria-pressed="false" class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low hover:bg-secondary-container/40 transition-colors cursor-pointer group">
<div class="flex items-center gap-2.5">
<span class="w-2.5 h-2.5 rounded-full bg-outline"></span>
<span class="font-label-lg text-label-lg text-on-surface group-hover:text-primary-container">Envergure Sud Océan Indien</span>
    </div>
<span class="font-label-md text-label-md bg-surface-container px-2.5 py-0.5 rounded-full text-primary-container font-semibold">20 acteurs</span>
</li>
            </ul>
</div>
<!-- Highlight Box -->
<div class="bg-secondary-container/50 rounded-lg p-space-md text-primary-container">
<div class="flex items-start gap-space-xs">
<span class="material-symbols-outlined text-[24px]">verified_user</span>
<div>
<div class="font-label-lg text-label-lg font-bold">Réseau Opérationnel ARB</div>
<p class="font-body-sm text-body-sm text-secondary mt-1">
                  Chaque entité répertoriée dispose d'une fiche d'agrément validée par le comité scientifique de l'Agence Régionale de la Biodiversité.
                </p>
</div>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- ORGANIC WAVE DIVIDER: surface-container to surface-bright -->
<div class="w-full text-surface-bright bg-surface-container leading-none select-none pointer-events-none -mt-1">
<svg class="w-full h-10 md:h-16" fill="currentColor" preserveAspectRatio="none" viewBox="0 -16 1440 80">
<path d="M0,32 C260,-10 520,60 780,24 C1040,-12 1280,50 1440,20 L1440,64 L0,64 Z"></path>
</svg>
</div>
<!-- 3. FILTRES AVANCÉS & FACETTES THEMATIQUES -->
<section class="bg-surface-bright py-space-md">
<div class="max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<!-- Facet: Types de structures -->
<div class="mb-space-md">
<div class="flex items-center justify-between mb-3">
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px]">category</span>
            TYPES DE STRUCTURE
          </span>
<span class="text-xs text-secondary font-label-sm" id="results-count">9 résultats</span>
</div>
<div class="flex flex-wrap gap-2" id="filter-types">
<button type="button" data-type="" class="px-3.5 py-1.5 rounded-full font-label-md text-label-md bg-primary-container text-inverse-on-surface shadow-sm transition-all">
            Tous <span class="ml-1 opacity-80" data-count>(9)</span>
</button>
<button type="button" data-type="public" class="px-3.5 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-secondary-container hover:text-primary-container transition-all">
            Collectivités &amp; Établissements publics <span class="ml-1 text-secondary" data-count>(1)</span>
</button>
<button type="button" data-type="gest" class="px-3.5 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-secondary-container hover:text-primary-container transition-all">
            Gestionnaires d'espaces naturels &amp; Parcs <span class="ml-1 text-secondary" data-count>(3)</span>
</button>
<button type="button" data-type="recherche" class="px-3.5 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-secondary-container hover:text-primary-container transition-all">
            Laboratoires &amp; Recherche scientifique <span class="ml-1 text-secondary" data-count>(3)</span>
</button>
<button type="button" data-type="asso" class="px-3.5 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-secondary-container hover:text-primary-container transition-all">
            Associations de protection de la nature <span class="ml-1 text-secondary" data-count>(2)</span>
</button>
<button type="button" data-type="bureau" class="px-3.5 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-secondary-container hover:text-primary-container transition-all">
            Bureaux d'études &amp; Génie écologique <span class="ml-1 text-secondary" data-count>(1)</span>
</button>
<button type="button" data-type="pepiniere" class="px-3.5 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-secondary-container hover:text-primary-container transition-all">
            Pépinières agréées Végétal Péi <span class="ml-1 text-secondary" data-count>(0)</span>
</button>
</div>
</div>
<!-- Facet: Domaines d'expertise & Tri -->
<div class="pt-space-sm flex flex-col lg:flex-row lg:items-center justify-between gap-space-sm">
<div class="flex flex-wrap items-center gap-2" id="filter-expertises">
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mr-2 flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">psychology</span>
            EXPERTISES :
          </span>
<button type="button" data-expertise="marin" class="px-3 py-1 rounded-full text-xs font-label-md bg-surface-container-low text-secondary hover:bg-secondary-container hover:text-primary-container transition-colors">
            Milieu marin &amp; récifs
          </button>
<button type="button" data-expertise="forets" class="px-3 py-1 rounded-full text-xs font-label-md bg-surface-container-low text-secondary hover:bg-secondary-container hover:text-primary-container transition-colors">
            Forêts indigènes &amp; semi-sèches
          </button>
<button type="button" data-expertise="eee" class="px-3 py-1 rounded-full text-xs font-label-md bg-surface-container-low text-secondary hover:bg-secondary-container hover:text-primary-container transition-colors">
            Lutte contre les EEE
          </button>
<button type="button" data-expertise="avifaune" class="px-3 py-1 rounded-full text-xs font-label-md bg-surface-container-low text-secondary hover:bg-secondary-container hover:text-primary-container transition-colors">
            Trame noire &amp; avifaune
          </button>
<button type="button" data-expertise="education" class="px-3 py-1 rounded-full text-xs font-label-md bg-surface-container-low text-secondary hover:bg-secondary-container hover:text-primary-container transition-colors">
            Sensibilisation &amp; éducation
          </button>
<button type="button" data-expertise="droit" class="px-3 py-1 rounded-full text-xs font-label-md bg-surface-container-low text-secondary hover:bg-secondary-container hover:text-primary-container transition-colors">
            Droit &amp; réglementation
          </button>
</div>
<!-- Tri Sélecteur -->
<div class="flex shrink-0 items-center gap-2 self-end lg:self-auto">
<span class="whitespace-nowrap font-label-sm text-label-sm text-secondary">Trier par&nbsp;:</span>
<div class="relative">
<select class="pl-3 pr-8 py-1.5 rounded-full bg-surface-container-high text-on-surface font-label-md text-label-md focus:outline-none cursor-pointer appearance-none" id="filter-sort">
<option value="pertinence">Pertinence</option>
<option value="alpha">Alphabétique (A-Z)</option>
<option value="recent">Récemment mis à jour</option>
<option value="commune">Par Commune</option>
</select>
<span class="material-symbols-outlined absolute right-2.5 top-2 pointer-events-none text-secondary text-[16px]">expand_more</span>
</div>
</div>
</div>
</div>
</section>
<!-- 4. GRILLE DES FICHES D'ACTEURS (Cartes riches et détaillées) -->
<section class="bg-surface-bright py-space-lg">
<div class="max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg" id="actor-grid">
<!-- FICHE 1 : Parc National de La Réunion -->
<article data-actor data-id="parc" data-types="public gest" data-regions="hauts" data-expertises="forets" data-name="Parc National de La Réunion" data-place="La Plaine-des-Palmistes" data-updated="7" class="bg-surface-container-lowest rounded-lg overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
