---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { acteurs } from '../../data/acteurs';

export function getStaticPaths() {
  return acteurs.map((acteur) => ({
    params: { id: acteur.id },
    props: { acteur },
  }));
}

const { acteur } = Astro.props;
const autres = acteurs
  .filter((item) => item.id !== acteur.id)
  .sort((a, b) => Number(b.region === acteur.region) - Number(a.region === acteur.region))
  .slice(0, 3);
const maps = `https://maps.google.com/?q=${encodeURIComponent(`${acteur.address}, ${acteur.city}`)}`;
---

<Base title={`${acteur.name} — Annuaire ARB Réunion`}>
  <Header current="annuaire" />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]">
    <section class="page-hero hero-photo relative overflow-hidden pt-8 pb-24 lg:pb-32" style={`--hero-image: url('${acteur.image}')`}>
      <div class="max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin relative z-10">
        <nav aria-label="Fil d'Ariane" class="flex flex-wrap items-center gap-1 mb-6 font-label-md text-label-md text-secondary">
          <a class="hover:text-surface transition-colors inline-flex items-center gap-1" href="/">
            <span class="material-symbols-outlined text-[16px]">home</span>
            <span>Accueil</span>
          </a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <a class="hover:text-surface transition-colors" href="/annuaire">Annuaire</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="font-semibold">{acteur.name}</span>
        </nav>
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-surface-container-lowest text-primary-container font-label-sm text-label-sm">{acteur.type}</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-surface-container-lowest text-primary-container font-label-sm text-label-sm font-semibold">
            <span class="material-symbols-outlined text-[16px]">{acteur.badgeIcon}</span>
            {acteur.badge}
          </span>
        </div>
        <h1 class="max-w-4xl font-display-lg text-headline-lg md:text-display-lg text-primary leading-tight">{acteur.name}</h1>
        <p class="mt-4 inline-flex items-center gap-1 font-label-md text-label-md text-secondary">
          <span class="material-symbols-outlined text-[18px]">location_on</span>
          <span>{acteur.place}</span>
        </p>
      </div>
      <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none">
        <svg class="w-full h-12 md:h-20 text-surface fill-current block" preserveAspectRatio="none" viewBox="0 -16 1440 112">
          <path d="M0,32 C280,96 520,0 840,48 C1160,96 1360,16 1440,32 L1440,96 L0,96 Z"></path>
        </svg>
      </div>
    </section>

    <section class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin pt-4 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8">
          <p class="font-body-lg text-body-lg text-on-surface leading-relaxed">{acteur.summary}</p>
          <p class="mt-4 font-body-md text-body-md text-secondary leading-relaxed">{acteur.mission}</p>

          <h2 class="mt-10 font-headline-md text-headline-md text-primary">Domaines d'intervention</h2>
          <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 p-0 list-none">
            {acteur.domains.map((domain) => (
              <li class="rounded-lg bg-surface-container-lowest p-4">
                <p class="font-label-md text-label-md font-bold text-primary-container">{domain.label}</p>
                <p class="mt-1 font-body-sm text-body-sm text-secondary leading-relaxed">{domain.text}</p>
              </li>
            ))}
          </ul>

          <h2 class="mt-10 font-headline-md text-headline-md text-primary">Publications</h2>
          <ul class="mt-4 flex flex-col gap-2 p-0 list-none">
            {acteur.publications.map((publication) => (
              <li class="flex items-start gap-3 rounded-lg bg-surface-container-low px-4 py-3">
                <span class="shrink-0 px-2.5 py-0.5 rounded-full bg-secondary-container text-primary-container font-label-sm text-label-sm">{publication.year}</span>
                <span class="font-body-md text-body-md text-on-surface">{publication.title}</span>
              </li>
            ))}
          </ul>
        </div>

        <aside class="lg:col-span-4 lg:sticky lg:top-24 rounded-lg bg-surface-container-lowest p-6 shadow-sm">
          <p class="inline-flex items-center gap-1 font-label-sm text-label-sm text-secondary">
            <span class="material-symbols-outlined text-[16px] text-primary-container">check_circle</span>
            Fiche vérifiée ARB
          </p>
          <h2 class="mt-3 font-headline-sm text-headline-sm text-primary">Coordonnées</h2>
          <p class="mt-4 font-body-md text-body-md text-on-surface leading-relaxed">{acteur.address}<br />{acteur.city}</p>
          <div class="mt-4 flex flex-col gap-2">
            <a class="inline-flex items-center gap-2 font-label-md text-label-md font-bold text-primary-container hover:underline" href={`tel:${acteur.tel}`}>
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>{acteur.phone}</span>
            </a>
            <a class="inline-flex items-center gap-2 font-label-md text-label-md font-bold text-primary-container hover:underline" href={`mailto:${acteur.email}`}>
              <span class="material-symbols-outlined text-[18px]">mail</span>
              <span>{acteur.email}</span>
            </a>
            <p class="font-body-sm text-body-sm text-secondary">{acteur.referent}</p>
          </div>
          <div class="mt-6 flex flex-col gap-2">
            <a class="inline-flex items-center justify-center gap-2 min-h-[44px] px-4 rounded-full bg-primary-container text-inverse-on-surface font-label-md text-label-md hover:bg-primary" href={`mailto:${acteur.email}`}>
              Écrire à la structure
            </a>
            <a class="inline-flex items-center justify-center gap-2 min-h-[44px] px-4 rounded-full bg-surface-container text-primary-container font-label-md text-label-md hover:bg-secondary-container" href={maps} rel="noopener noreferrer" target="_blank">
              <span class="material-symbols-outlined text-[18px]">directions</span>
              Itinéraire
            </a>
            <a class="inline-flex items-center justify-center gap-1 min-h-[44px] px-4 font-label-md text-label-md text-secondary hover:text-primary" href="/annuaire">
              <span class="material-symbols-outlined text-[18px]">arrow_back</span>
              Retour à l'annuaire
            </a>
          </div>
        </aside>
      </div>

      <h2 class="mt-14 font-headline-md text-headline-md text-primary">Autres structures</h2>
      <ul class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4 p-0 list-none">
        {autres.map((autre) => (
          <li>
            <a class="flex flex-col h-full rounded-lg bg-surface-container-lowest p-5 hover:shadow-md transition-shadow" href={`/annuaire/${autre.id}`}>
              <span class="font-label-sm text-label-sm text-secondary">{autre.type}</span>
              <span class="mt-2 font-headline-sm text-headline-sm text-primary">{autre.name}</span>
              <span class="mt-2 font-body-sm text-body-sm text-secondary">{autre.place}</span>
              <span class="mt-4 inline-flex items-center gap-1 font-label-md text-label-md font-semibold text-primary-container">
                Détails
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Base>
