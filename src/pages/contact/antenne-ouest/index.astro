---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<Base title="Antenne Ouest, Saint-Paul — ARB Réunion">
  <Header current="contact" />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]"><div class="flex flex-col w-full">
<!-- Top Hero & Territorial Identity Section -->
<section class="page-hero hero-photo relative w-full overflow-hidden pt-space-lg pb-space-xl" style="--hero-image: url('/images/bandeaux/littoral.webp')">
<!-- Atmospheric subtle circular decorative glows -->
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin relative z-10">
<!-- Breadcrumbs -->
<nav aria-label="Fil d'Ariane" class="flex items-center gap-space-xs text-on-surface-variant font-label-sm text-label-sm mb-space-md">
<a class="hover:text-primary transition-colors flex items-center gap-1" href="#">
<span class="material-symbols-outlined text-[16px]">home</span>
<span>Accueil</span>
</a>
<span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
<a class="hover:text-primary transition-colors" href="#">Contact &amp; Antennes</a>
<span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
<span class="text-primary font-bold">Antenne Ouest (Saint-Paul)</span>
</nav>
