                    Téléphone direct
                  </span>
<a class="font-headline-sm text-[18px] text-primary hover:text-secondary block mt-1" href="tel:0262902022">
                    0262 90 20 22
                  </a>
</div>
<div class="p-space-sm rounded-lg bg-surface-container-low">
<span class="font-label-sm text-label-sm text-secondary uppercase flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">alternate_email</span>
                    Courriel territorial
                  </span>
<a class="font-label-md text-label-md text-primary hover:text-secondary block mt-1 break-words" href="mailto:antenne-ouest@arb-reunion.fr">
