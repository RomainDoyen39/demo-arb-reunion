<div class="max-w-4xl flex flex-col gap-space-xs">
<div class="inline-flex items-center gap-space-xs self-start px-space-sm py-1 rounded-full bg-secondary-container text-primary-container font-label-md text-label-md">
<span class="material-symbols-outlined text-[18px]">waves</span>
<span>Antenne Territoriale Ouest • Bassin Versant Sous-le-Vent</span>
</div>
<h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary tracking-tight leading-none mt-space-xs">
            Milieux Littoraux, Récifs &amp; Savanes
          </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl mt-space-xs leading-relaxed">
            Point d'ancrage opérationnel de l'ARB Réunion pour les communes de <strong>Saint-Paul</strong>, <strong>Le Port</strong>, <strong>La Possession</strong>, <strong>Trois-Bassins</strong> et <strong>Saint-Leu</strong>. Pôle d'expertise dédié aux écosystèmes côtiers, au lagon corallien, aux reliques de forêts semi-sèches et à la zone humide protégée de l'Étang.
          </p>
</div>
<!-- Quick Contact Actions -->
<div class="flex flex-wrap lg:flex-col items-stretch gap-space-xs min-w-[260px]">
<a class="inline-flex items-center justify-center gap-space-xs min-h-[46px] px-space-lg py-space-xs rounded-full bg-primary-container text-inverse-on-surface hover:bg-primary font-label-lg text-label-lg transition-all shadow-md" href="#permanences">
<span class="material-symbols-outlined text-[20px]">calendar_month</span>
<span>Prendre RDV permanence</span>
</a>
<a class="inline-flex items-center justify-center gap-space-xs min-h-[46px] px-space-lg py-space-xs rounded-full bg-surface-container-high text-primary hover:bg-secondary-container font-label-lg text-label-lg transition-all" href="#contact-direct">
<span class="material-symbols-outlined text-[20px]">mail</span>
<span>Contacter l'antenne</span>
</a>
</div>
</div>
<!-- Key Operational Indicator Badges -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-space-sm pt-space-xs">
<div class="flex items-center gap-space-xs p-space-sm rounded-lg bg-surface-container-low shadow-sm">
