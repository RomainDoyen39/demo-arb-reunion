<section class="w-full bg-surface-container-low py-space-xl">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<div class="flex flex-col mb-space-lg">
<span class="font-label-sm text-label-sm text-tertiary uppercase tracking-wider">Implantation Locale</span>
<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary">
          Fiche d'Identité &amp; Accès Cambaie
        </h2>
<p class="font-body-md text-body-md text-on-surface-variant max-w-2xl mt-1">
          Installée au cœur du bassin d'activités et végétal de Cambaie, l'antenne assure une proximité immédiate avec les ravines de Saint-Paul, le littoral balnéaire et les grands axes du Sous-le-Vent.
        </p>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-stretch">
<!-- Colonne Gauche: Informations pratiques -->
<div class="lg:col-span-5 flex flex-col gap-space-md">
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between h-full">
<div class="flex flex-col gap-space-md">
<div class="flex items-start gap-space-sm pb-space-sm">
<div class="w-12 h-12 rounded-full bg-primary-container text-inverse-on-surface flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[24px]">location_on</span>
</div>
<div>
