<div class="lg:col-span-7 flex flex-col">
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col h-full">
<div class="flex items-center justify-between mb-space-sm">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-[24px]">map</span>
<h3 class="font-headline-sm text-headline-sm text-primary">Périmètre d'Intervention &amp; Réseau Partenaire</h3>
</div>
<span class="font-label-sm text-label-sm text-secondary bg-surface-container px-space-xs py-1 rounded-full">
