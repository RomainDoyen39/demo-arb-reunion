---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Base title="Contact et antennes — ARB Réunion">
  <Header current="contact" />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]"><div class="flex flex-col w-full">
<!-- SECTION HERO & FIL D'ARIANE -->
<section class="page-hero relative w-full overflow-hidden pt-8 pb-28 md:pb-36">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin relative z-10">
<!-- Breadcrumb -->
<nav aria-label="Fil d'Ariane" class="flex items-center gap-space-xs text-secondary mb-6 font-label-md text-label-md">
<a class="hover:text-primary-container transition-colors flex items-center gap-1" data-path="accueil" href="/">
<span class="material-symbols-outlined text-[16px]">home</span>
<span>Accueil</span>
</a>
<span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
<span class="text-primary-container font-semibold">Contact &amp; Antennes territoriales</span>
</nav>
<!-- Pill Badge -->
<div class="inline-flex items-center gap-space-xs px-space-md py-1.5 rounded-full bg-secondary-container text-primary-container font-label-md text-label-md mb-6 shadow-sm">
<span class="material-symbols-outlined text-[18px]">location_on</span>
<span>Proximité insulaire &amp; Accompagnement de terrain</span>
</div>
<!-- Main Heading & Intro -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-end mb-12">
<div class="lg:col-span-8 flex flex-col gap-4">
<h1 class="font-display-lg text-display-lg text-primary-container tracking-tight leading-none">
            Contact &amp; Antennes territoriales
          </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl leading-relaxed">
            Échangez directement avec nos équipes d'écologues, botanistes, géomaticiens et chargés de mission. Que vous représentiez une collectivité, un bureau d'études, une association ou le monde citoyen, nos 4 pôles répartis sur les micro-régions de La Réunion vous garantissent un conseil indépendant et ancré dans vos bassins versants.
          </p>
</div>
<div class="lg:col-span-4 flex justify-start lg:justify-end">
<a class="inline-flex items-center justify-center gap-2 px-space-lg py-3.5 rounded-full bg-primary-container text-inverse-on-surface hover:bg-primary font-label-lg text-label-lg transition-all shadow-[0_8px_20px_rgba(17,78,74,0.18)]" href="#formulaire-contact">
<span>Écrire à un référent</span>
<span class="material-symbols-outlined text-[18px]">arrow_downward</span>
</a>
</div>
</div>
<!-- 4 Quick Key Indicators -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
<div class="p-space-md rounded-2xl bg-white shadow-sm flex items-center gap-space-sm">
<div class="w-12 h-12 rounded-full bg-secondary-container/60 text-primary-container flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[24px]">map</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-[16px] text-primary-container font-semibold leading-tight">4 Antennes de proximité</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Nord, Ouest, Sud, Est &amp; Cirques</span>
</div>
</div>
<div class="p-space-md rounded-2xl bg-white shadow-sm flex items-center gap-space-sm">
<div class="w-12 h-12 rounded-full bg-secondary-container/60 text-primary-container flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[24px]">schedule</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-[16px] text-primary-container font-semibold leading-tight">Réponse sous 48h ouvrées</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Prise en charge par un référent</span>
</div>
</div>
<div class="p-space-md rounded-2xl bg-white shadow-sm flex items-center gap-space-sm">
<div class="w-12 h-12 rounded-full bg-secondary-container/60 text-primary-container flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[24px]">calendar_month</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-[16px] text-primary-container font-semibold leading-tight">Permanences techniques</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Mardis &amp; Jeudis sur rdv</span>
</div>
</div>
<div class="p-space-md rounded-2xl bg-white shadow-sm flex items-center gap-space-sm">
<div class="w-12 h-12 rounded-full bg-tertiary-fixed/70 text-tertiary-container flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[24px]">verified</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-[16px] text-primary-container font-semibold leading-tight">100% Service public</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Accompagnement neutre &amp; gratuit</span>
</div>
</div>
</div>
</div>
<div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none">
<svg class="block h-12 w-full fill-current text-surface md:h-20" preserveAspectRatio="none" viewBox="0 0 1440 96">
<path d="M0,32 C280,96 520,0 840,48 C1160,96 1360,16 1440,32 L1440,96 L0,96 Z"></path>
</svg>
</div>
</section>
<!-- SECTION 2 : CARTE & LES 4 ANTENNES TERRITORIALES -->
<section class="relative -mt-px w-full bg-surface py-12 md:py-16">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<!-- Section Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-12">
<div class="max-w-2xl">
<div class="inline-flex items-center gap-2 text-tertiary-container font-label-md text-label-md mb-2 uppercase tracking-widest">
<span class="w-2.5 h-2.5 rounded-full bg-tertiary-container"></span>
<span>Maillage Insulaire</span>
</div>
<h2 class="font-headline-lg text-headline-lg text-primary-container tracking-tight">
            Nos 4 antennes de proximité
          </h2>
<p class="font-body-md text-body-md text-on-surface-variant mt-2">
            Un déploiement géographique pensé pour répondre aux spécificités des écosystèmes insulaires : récifs de la côte sous le vent, massifs forestiers hygrophiles de l'Est, téléfériques des Hauts et corridors du Sud sauvage.
          </p>
</div>
<div class="flex items-center gap-2 self-start md:self-auto">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container/60 text-primary-container font-label-sm text-label-sm">
<span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
            Guichets ouverts aujourd'hui
          </span>
</div>
</div>
<!-- 4 Poles Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
<!-- Antenne 1: Nord (Siège) -->
<article class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between relative overflow-hidden group">
<div class="absolute top-0 right-0 w-32 h-32 bg-secondary-container/20 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
<div>
<div class="flex items-start justify-between gap-3 mb-4">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-primary-container font-label-sm text-label-sm font-semibold">
<span class="material-symbols-outlined text-[15px]">corporate_fare</span>
                Nord &amp; Siège Régional
              </span>
<span class="font-label-sm text-label-sm text-secondary bg-surface-container px-2.5 py-1 rounded-full">
                Sainte-Marie (La Mare)
              </span>
</div>
<h3 class="font-headline-md text-headline-md text-primary-container mb-1">
              Siège &amp; Observatoire (ORB)
            </h3>
<p class="font-body-sm text-body-sm text-tertiary-container font-medium mb-4">
              Administration générale, Plateforme Borbonica &amp; Synthèse scientifique
            </p>
<div class="space-y-2.5 mb-6 text-on-surface-variant font-body-sm text-body-sm">
<div class="flex items-start gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5">location_on</span>
<span>10 rue Pierre Marinier, Bâtiment Cyathea, 97438 Sainte-Marie</span>
</div>
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0">call</span>
<span class="font-semibold text-on-surface">0262 90 20 20</span>
</div>
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0">schedule</span>
<span>Lundi au Vendredi : 08h00 - 17h00 (sans interruption)</span>
</div>
<div class="flex items-start gap-2.5 pt-1">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5">groups</span>
<span class="text-body-sm">Direction générale, Observatoire Régional de la Biodiversité (ORB), pôle SIG Borbonica, équipe réglementation &amp; subventions.</span>
</div>
</div>
</div>
<div class="flex items-center gap-3 pt-4 border-t border-surface-container-high">
<a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-surface-container hover:bg-surface-variant text-on-surface font-label-md text-label-md transition-colors" href="https://maps.google.com/?q=Sainte-Marie+La+Reunion" rel="noopener noreferrer" target="_blank">
<span class="material-symbols-outlined text-[16px]">directions</span>
<span>Itinéraire</span>
</a>
<a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary-container text-inverse-on-surface hover:bg-primary font-label-md text-label-md transition-colors ml-auto" href="#formulaire-contact">
<span>Contacter l'antenne</span>
<span class="material-symbols-outlined text-[16px]">mail</span>
</a>
</div>
</article>
<!-- Antenne 2: Ouest -->
<article class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between relative overflow-hidden group">
<div class="absolute top-0 right-0 w-32 h-32 bg-secondary-container/20 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
<div>
<div class="flex items-start justify-between gap-3 mb-4">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-primary-container font-label-sm text-label-sm font-semibold">
<span class="material-symbols-outlined text-[15px]">waves</span>
                Pôle Ouest
              </span>
<span class="font-label-sm text-label-sm text-secondary bg-surface-container px-2.5 py-1 rounded-full">
                Saint-Paul (Cambaie)
              </span>
</div>
<h3 class="font-headline-md text-headline-md text-primary-container mb-1">
              Milieux Littoraux &amp; Récifs
            </h3>
<p class="font-body-sm text-body-sm text-tertiary-container font-medium mb-4">
              Écologie marine, lagon corallien &amp; Zones humides littorales
            </p>
<div class="space-y-2.5 mb-6 text-on-surface-variant font-body-sm text-body-sm">
<div class="flex items-start gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5">location_on</span>
<span>24 Rue de la Pépinière, Zone Cambaie, 97460 Saint-Paul</span>
</div>
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0">call</span>
<span class="font-semibold text-on-surface">0262 90 20 22</span>
</div>
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0">schedule</span>
<span>Lundi au Vendredi : 08h00 - 16h30</span>
</div>
<div class="flex items-start gap-2.5 pt-1">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5">groups</span>
<span class="text-body-sm">Écologues marins, spécialistes forêts sèches (Étang de Saint-Paul, Savane), référents continuités récifales &amp; canopée urbaine.</span>
</div>
</div>
</div>
<div class="flex items-center gap-3 pt-4 border-t border-surface-container-high">
<a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-surface-container hover:bg-surface-variant text-on-surface font-label-md text-label-md transition-colors" href="https://maps.google.com/?q=Saint-Paul+La+Reunion" rel="noopener noreferrer" target="_blank">
<span class="material-symbols-outlined text-[16px]">directions</span>
<span>Itinéraire</span>
</a>
<a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary-container text-inverse-on-surface hover:bg-primary font-label-md text-label-md transition-colors ml-auto" href="/contact/antenne-ouest">
<span>Contacter l'antenne</span>
<span class="material-symbols-outlined text-[16px]">mail</span>
</a>
</div>
</article>
<!-- Antenne 3: Sud -->
<article class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between relative overflow-hidden group">
<div class="absolute top-0 right-0 w-32 h-32 bg-secondary-container/20 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
<div>
<div class="flex items-start justify-between gap-3 mb-4">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-primary-container font-label-sm text-label-sm font-semibold">
<span class="material-symbols-outlined text-[15px]">terrain</span>
                Pôle Sud
              </span>
<span class="font-label-sm text-label-sm text-secondary bg-surface-container px-2.5 py-1 rounded-full">
                Saint-Pierre (Bassin Plat)
              </span>
</div>
<h3 class="font-headline-md text-headline-md text-primary-container mb-1">
              Forêts d'altitude &amp; Trames Noires
            </h3>
<p class="font-body-sm text-body-sm text-tertiary-container font-medium mb-4">
              Avifaune marine pélagique, corridors volcaniques &amp; écologie nocturne
            </p>
<div class="space-y-2.5 mb-6 text-on-surface-variant font-body-sm text-body-sm">
<div class="flex items-start gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5">location_on</span>
<span>8 Chemin des Découvertes, Bassin Plat, 97410 Saint-Pierre</span>
</div>
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0">call</span>
<span class="font-semibold text-on-surface">0262 90 20 24</span>
</div>
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0">schedule</span>
<span>Lundi au Vendredi : 08h00 - 16h30</span>
</div>
<div class="flex items-start gap-2.5 pt-1">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5">groups</span>
<span class="text-body-sm">Ingénieurs trame nocturne (protection Pétrel de Barau / Pétrel noir), écologues du massif du Piton de la Fournaise et des Makes.</span>
</div>
</div>
</div>
<div class="flex items-center gap-3 pt-4 border-t border-surface-container-high">
<a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-surface-container hover:bg-surface-variant text-on-surface font-label-md text-label-md transition-colors" href="https://maps.google.com/?q=Saint-Pierre+La+Reunion" rel="noopener noreferrer" target="_blank">
<span class="material-symbols-outlined text-[16px]">directions</span>
<span>Itinéraire</span>
</a>
<a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary-container text-inverse-on-surface hover:bg-primary font-label-md text-label-md transition-colors ml-auto" href="#formulaire-contact">
<span>Contacter l'antenne</span>
<span class="material-symbols-outlined text-[16px]">mail</span>
</a>
</div>
</article>
<!-- Antenne 4: Est & Cirques -->
<article class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between relative overflow-hidden group">
<div class="absolute top-0 right-0 w-32 h-32 bg-secondary-container/20 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
<div>
<div class="flex items-start justify-between gap-3 mb-4">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-primary-container font-label-sm text-label-sm font-semibold">
<span class="material-symbols-outlined text-[15px]">forest</span>
                Pôle Est &amp; Cirques
              </span>
<span class="font-label-sm text-label-sm text-secondary bg-surface-container px-2.5 py-1 rounded-full">
                Saint-Benoît &amp; Relais Hauts
              </span>
</div>
<h3 class="font-headline-md text-headline-md text-primary-container mb-1">
              Forêts humides, Ravines &amp; Invasives
            </h3>
<p class="font-body-sm text-body-sm text-tertiary-container font-medium mb-4">
              Restauration de ripisylves, lutte contre les EEE &amp; suivis forêts primaires
            </p>
<div class="space-y-2.5 mb-6 text-on-surface-variant font-body-sm text-body-sm">
<div class="flex items-start gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5">location_on</span>
<span>15 Allée des Palmiers, 97470 Saint-Benoît (Permanence Salazie &amp; Cilaos)</span>
</div>
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0">call</span>
<span class="font-semibold text-on-surface">0262 90 20 26</span>
</div>
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0">schedule</span>
<span>Lundi au Vendredi : 08h00 - 16h30</span>
</div>
<div class="flex items-start gap-2.5 pt-1">
<span class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5">groups</span>
<span class="text-body-sm">Botanistes forêts de bébour-bélouve, coordinateurs de lutte contre les pestes végétales (EEE), spécialistes continuités hydrobiologiques.</span>
</div>
</div>
</div>
<div class="flex items-center gap-3 pt-4 border-t border-surface-container-high">
<a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-surface-container hover:bg-surface-variant text-on-surface font-label-md text-label-md transition-colors" href="https://maps.google.com/?q=Saint-Benoit+La+Reunion" rel="noopener noreferrer" target="_blank">
<span class="material-symbols-outlined text-[16px]">directions</span>
<span>Itinéraire</span>
</a>
<a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary-container text-inverse-on-surface hover:bg-primary font-label-md text-label-md transition-colors ml-auto" href="#formulaire-contact">
<span>Contacter l'antenne</span>
<span class="material-symbols-outlined text-[16px]">mail</span>
</a>
</div>
</article>
</div>
</div>
</section>
<!-- WAVE TRANSITION 2 -->
<div aria-hidden="true" class="w-full overflow-hidden leading-none -mt-1 bg-surface text-surface-container-low">
<svg class="w-full h-12 md:h-20 fill-surface-container-low" preserveAspectRatio="none" viewBox="0 0 1440 80">
<path d="M0,45 C280,10 500,75 820,30 C1100,-10 1280,60 1440,25 L1440,80 L0,80 Z"></path>
</svg>
</div>
<!-- SECTION 3 : FORMULAIRE DE CONTACT & ORIENTATION D'URGENCE -->
<section class="w-full bg-surface-container-low py-12 md:py-20" id="formulaire-contact">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl">
<!-- Colonne Gauche : Réassurance & Interlocuteurs d'urgence -->
<div class="lg:col-span-5 flex flex-col gap-8">
<div>
<div class="inline-flex items-center gap-2 text-tertiary-container font-label-md text-label-md mb-2 uppercase tracking-widest">
<span class="material-symbols-outlined text-[16px]">support_agent</span>
<span>Orientation directe</span>
</div>
<h2 class="font-headline-lg text-headline-lg text-primary-container tracking-tight mb-4">
              Vous orienter vers le bon interlocuteur
            </h2>
<p class="font-body-md text-body-md text-on-surface-variant mb-8 leading-relaxed">
              L'ARB Réunion est l'établissement public de coordination et d'appui aux décisions. Pour des situations d'urgence immédiate sur le terrain insulaire, veuillez contacter prioritairement les réseaux de veille dédiés :
            </p>
<!-- Cards Réseau d'Urgence Faune / Flore -->
<div class="space-y-3.5">
<!-- Urgence 1 : Pétrel / Avifaune -->
<div class="p-4 rounded-xl bg-surface-container-lowest shadow-sm flex items-start gap-3.5">
<div class="w-10 h-10 rounded-full bg-tertiary-fixed text-tertiary-container flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[20px]">cruelty_free</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-[15px] text-primary-container font-semibold">Échouage d'oiseau marin (Pétrel, Puffin)</span>
<p class="font-body-sm text-body-sm text-on-surface-variant mb-1">Mettre l'oiseau dans un carton aéré, sans eau ni nourriture, puis appeler immédiatement :</p>
<a class="text-tertiary-container font-bold font-label-md text-label-md hover:underline inline-flex items-center gap-1" href="tel:0262204665">
<span class="material-symbols-outlined text-[16px]">call</span> SEOR : 0262 20 46 65 (7j/7)
                  </a>
</div>
</div>
<!-- Urgence 2 : Tortue marine -->
<div class="p-4 rounded-xl bg-surface-container-lowest shadow-sm flex items-start gap-3.5">
<div class="w-10 h-10 rounded-full bg-secondary-container text-primary-container flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[20px]">phishing</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-[15px] text-primary-container font-semibold">Tortue marine en détresse ou ponte</span>
<p class="font-body-sm text-body-sm text-on-surface-variant mb-1">Ne pas manipuler l'animal, garder une distance de 10 mètres :</p>
<a class="text-primary-container font-bold font-label-md text-label-md hover:underline inline-flex items-center gap-1" href="tel:0262348110">
<span class="material-symbols-outlined text-[16px]">call</span> Centre de soins Kélonia : 0262 34 81 10
                  </a>
</div>
</div>
<!-- Urgence 3 : Espèces Invasives -->
<div class="p-4 rounded-xl bg-surface-container-lowest shadow-sm flex items-start gap-3.5">
<div class="w-10 h-10 rounded-full bg-surface-container-highest text-on-surface-variant flex items-center justify-center shrink-0">
