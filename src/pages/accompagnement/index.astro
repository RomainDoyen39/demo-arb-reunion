---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Base title="Accompagnement et projets — ARB Réunion">
  <Header />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]"><div class="flex flex-col w-full">
<!-- SECTION 1: HERO D'ORIENTATION & PRÉSENTATION -->
<section class="page-hero relative w-full pt-space-lg lg:pt-space-xl overflow-hidden">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<!-- Trait d'en-tête & Fil d'ariane contextuel -->
<div class="flex items-center gap-space-xs text-secondary mb-space-sm">
<span class="material-symbols-outlined text-[18px]">nature_people</span>
<span class="font-label-sm text-label-sm uppercase tracking-wider font-bold">Dispositifs Régionaux d'Appui 2024-2025</span>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center mb-space-xl">
<div class="lg:col-span-8 flex flex-col gap-space-md">
<h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary tracking-tight font-normal leading-[1.08]">
            Accompagnement &amp; Projets de Territoire
          </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl leading-relaxed">
            Nous soutenons les collectivités, entreprises, gestionnaires et associations réunionnaises pour intégrer la biodiversité au cœur de leurs actions d'aménagement, du littoral des Bas jusqu'aux cirques et forêts des Hauts.
          </p>
<!-- Badges de synthèse d'impact -->
<div class="flex flex-wrap items-center gap-space-sm pt-space-xs">
<span class="inline-flex items-center gap-2 px-space-md py-1.5 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
              24 communes réunionnaises éligibles
            </span>
<span class="inline-flex items-center gap-2 px-space-md py-1.5 rounded-full bg-surface-variant text-on-surface-variant font-label-md text-label-md">
<span class="material-symbols-outlined text-[16px]">account_balance</span>
              Fonds Région • FEDER • OFB
            </span>
<span class="inline-flex items-center gap-2 px-space-md py-1.5 rounded-full bg-surface-container-high text-secondary font-label-md text-label-md">
<span class="material-symbols-outlined text-[16px]">verified</span>
              Ingénierie publique gratuite
            </span>
</div>
</div>
<div class="lg:col-span-4 flex flex-col items-start lg:items-end justify-center">
<div class="w-full bg-surface-container-lowest p-space-md rounded-lg shadow-sm flex flex-col gap-space-sm">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary">Guichet Unique Régional</span>
<span class="font-label-sm text-label-sm text-primary font-bold">Session Ouverte</span>
</div>
<div class="font-headline-sm text-headline-sm text-primary leading-tight">
              3,4 M€ alloués
            </div>
<p class="font-body-sm text-body-sm text-on-surface-variant">
              Appui technique, expertises naturalistes et subventions ciblées pour les projets insulaires à fort gain écologique.
            </p>
<a class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-space-md rounded-full bg-primary-container text-inverse-on-surface hover:bg-primary font-label-lg text-label-lg transition-all" href="#demande-accompagnement">
<span>Déposer un dossier</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</div>
</div>
</div>
<!-- Filtres d'orientation usagers interactifs -->
<div class="w-full bg-surface-container-lowest rounded-lg p-space-md shadow-sm -mb-6 relative z-20">
<div class="flex flex-col md:flex-row md:items-center justify-between gap-space-sm mb-space-md">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-[22px]">tune</span>
<span class="font-headline-sm text-headline-sm text-primary">Trouvez l'appui adapté à votre profil</span>
</div>
<span class="font-label-sm text-label-sm text-secondary">Sélectionnez votre statut pour filtrer les dispositifs</span>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-space-sm" id="user-filter-group">
<button class="group flex items-start gap-space-sm p-space-md rounded-DEFAULT bg-secondary-container text-primary transition-all text-left" id="filter-collectivite" onclick="selectUserFilter('collectivite')" type="button">
<div class="w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary group-hover:scale-105 transition-transform flex-shrink-0">
<span class="material-symbols-outlined text-[22px]">location_city</span>
</div>
<div class="flex flex-col min-w-0">
<span class="font-label-lg text-label-lg font-bold text-on-secondary-fixed">Je suis une Collectivité / Mairie</span>
<span class="font-body-sm text-body-sm text-on-secondary-container truncate">TEN, Trame Verte et Bleue, PLU durable</span>
</div>
</button>
<button class="group flex items-start gap-space-sm p-space-md rounded-DEFAULT bg-surface-container-high hover:bg-surface-variant text-on-surface transition-all text-left" id="filter-entreprise" onclick="selectUserFilter('entreprise')" type="button">
<div class="w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center text-secondary group-hover:scale-105 transition-transform flex-shrink-0">
<span class="material-symbols-outlined text-[22px]">domain</span>
</div>
<div class="flex flex-col min-w-0">
<span class="font-label-lg text-label-lg font-bold text-on-surface">Je suis une Entreprise / Aménageur</span>
<span class="font-body-sm text-body-sm text-on-surface-variant truncate">Génie écologique, compensation, friches</span>
</div>
</button>
<button class="group flex items-start gap-space-sm p-space-md rounded-DEFAULT bg-surface-container-high hover:bg-surface-variant text-on-surface transition-all text-left" id="filter-association" onclick="selectUserFilter('association')" type="button">
<div class="w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center text-secondary group-hover:scale-105 transition-transform flex-shrink-0">
<span class="material-symbols-outlined text-[22px]">diversity_3</span>
</div>
<div class="flex flex-col min-w-0">
<span class="font-label-lg text-label-lg font-bold text-on-surface">Je suis une Association / Chercheur</span>
<span class="font-body-sm text-body-sm text-on-surface-variant truncate">Subventions FEDER, sciences citoyennes</span>
</div>
</button>
</div>
</div>
</div>
<!-- Transition Vague SVG 1 -->
<div aria-hidden="true" class="w-full text-surface leading-none relative z-10 pt-16">
<svg class="w-full h-16 md:h-24 fill-current block" preserveAspectRatio="none" viewBox="0 0 1440 96">
<path d="M0,32 C280,90 440,8 720,54 C1000,98 1240,24 1440,68 L1440,96 L0,96 Z"></path>
</svg>
</div>
</section>
<!-- SECTION 2: DISPOSITIFS D'AIDE ET INGÉNIERIE TERRITORIALE -->
<section class="w-full bg-surface py-space-xl">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-xl">
<div class="flex flex-col gap-space-xs max-w-2xl">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary">Ingénierie &amp; Financements</span>
<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary tracking-tight">
            Les 4 dispositifs phares de l'ARB Réunion
          </h2>
<p class="font-body-md text-body-md text-on-surface-variant">
            Une gamme complète d'outils opérationnels, d'expertises de terrain et de leviers financiers pour concrétiser vos projets de restauration écologique.
          </p>
</div>
<div class="flex items-center gap-space-xs">
<span class="font-label-md text-label-md text-secondary">Éligibilité vérifiée par nos instructeurs</span>
<span class="material-symbols-outlined text-surface-tint">verified_user</span>
</div>
</div>
<!-- Grille des 4 Cartes de Services -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
<!-- Carte A: Appels à projets Biodiversité Réunion -->
<article class="dispositif-card flex flex-col justify-between p-space-lg rounded-lg bg-surface-container-low hover:bg-surface-container transition-all group" data-category="collectivite association entreprise">
<div>
<div class="flex items-center justify-between gap-2 mb-space-md">
<span class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-tertiary-container text-on-tertiary-container font-label-sm text-label-sm uppercase tracking-wider font-bold">
<span class="material-symbols-outlined text-[14px]">local_fire_department</span>
                Clôture le 30 Avril 2025
              </span>
<span class="font-label-sm text-label-sm text-secondary">Région Réunion • FEDER</span>
</div>
<div class="flex items-start gap-space-md mb-space-sm">
<div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center text-primary-container flex-shrink-0 group-hover:scale-105 transition-transform">
<span class="material-symbols-outlined text-[26px]">payments</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-primary mb-1">
                  Appels à projets Biodiversité Réunion
                </h3>
<p class="font-label-md text-label-md text-secondary">Subventions directes en investissement &amp; fonctionnement</p>
</div>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mb-space-md leading-relaxed">
              Cofinancement à hauteur de 80% des études préalables, chantiers de lutte contre les invasives et création de corridors écologiques. Enveloppe globale dédiée de 2,1 M€ pour la cohésion insulaire.
            </p>
<div class="grid grid-cols-2 gap-space-sm p-space-sm rounded-DEFAULT bg-surface-container-lowest mb-space-md">
<div>
<div class="font-label-sm text-label-sm text-secondary">Montant financé</div>
<div class="font-headline-sm text-headline-sm text-primary">Jusqu'à 150 000 €</div>
</div>
<div>
<div class="font-label-sm text-label-sm text-secondary">Taux d'intervention</div>
<div class="font-headline-sm text-headline-sm text-surface-tint">Jusqu'à 80% HT</div>
</div>
</div>
</div>
<div class="flex items-center justify-between pt-space-sm">
<span class="font-label-sm text-label-sm text-on-surface-variant">Public : Collectivités, Associations, GIE</span>
<a class="inline-flex items-center gap-1.5 font-label-lg text-label-lg text-primary hover:text-surface-tint group/link" href="#candidature">
<span>Cahier des charges</span>
<span class="material-symbols-outlined text-[18px] group-hover/link:translate-x-1 transition-transform">download</span>
</a>
</div>
</article>
<!-- Carte B: Reconnaissance TEN -->
<article class="dispositif-card flex flex-col justify-between p-space-lg rounded-lg bg-surface-container-low hover:bg-surface-container transition-all group" data-category="collectivite">
<div>
<div class="flex items-center justify-between gap-2 mb-space-md">
<span class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-secondary-container text-primary-container font-label-sm text-label-sm uppercase tracking-wider font-bold">
<span class="material-symbols-outlined text-[14px]">military_tech</span>
                Label d'État 3 ans
              </span>
<span class="font-label-sm text-label-sm text-secondary">Coordination ARB Réunion</span>
</div>
<div class="flex items-start gap-space-md mb-space-sm">
<div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center text-primary-container flex-shrink-0 group-hover:scale-105 transition-transform">
<span class="material-symbols-outlined text-[26px]">workspace_premium</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-primary mb-1">
                  Territoire Engagé pour la Nature (TEN)
                </h3>
<p class="font-label-md text-label-md text-secondary">Parcours d'excellence pour les 24 communes et EPCI</p>
</div>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mb-space-md leading-relaxed">
              Un programme national adapté aux réalités réunionnaises permettant d'élaborer un plan d'actions pluriannuel concret : renaturation des centres-villes, zéro phytosanitaire dans les parcs et sensibilisation scolaire.
            </p>
<div class="grid grid-cols-2 gap-space-sm p-space-sm rounded-DEFAULT bg-surface-container-lowest mb-space-md">
<div>
<div class="font-label-sm text-label-sm text-secondary">Communes lauréates</div>
<div class="font-headline-sm text-headline-sm text-primary">14 / 24 labellisées</div>
</div>
<div>
<div class="font-label-sm text-label-sm text-secondary">Accompagnement</div>
<div class="font-headline-sm text-headline-sm text-surface-tint">Expertise ARB dédiée</div>
</div>
</div>
</div>
<div class="flex items-center justify-between pt-space-sm">
<span class="font-label-sm text-label-sm text-on-surface-variant">Public : Mairies, Communautés d'Agglo</span>
<a class="inline-flex items-center gap-1.5 font-label-lg text-label-lg text-primary hover:text-surface-tint group/link" href="#contact-rdv">
<span>Engager ma commune</span>
<span class="material-symbols-outlined text-[18px] group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
</a>
</div>
</article>
<!-- Carte C: Trame Verte, Bleue & Noire -->
<article class="dispositif-card flex flex-col justify-between p-space-lg rounded-lg bg-surface-container-low hover:bg-surface-container transition-all group" data-category="collectivite entreprise">
<div>
<div class="flex items-center justify-between gap-2 mb-space-md">
<span class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-surface-container-high text-secondary font-label-sm text-label-sm uppercase tracking-wider font-bold">
<span class="material-symbols-outlined text-[14px]">nightlight</span>
                Continuités Écologiques
              </span>
<span class="font-label-sm text-label-sm text-secondary">Appui Technique &amp; SIG</span>
</div>
<div class="flex items-start gap-space-md mb-space-sm">
<div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center text-primary-container flex-shrink-0 group-hover:scale-105 transition-transform">
<span class="material-symbols-outlined text-[26px]">water_ec</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-primary mb-1">
                  Trame Verte, Bleue &amp; Noire
                </h3>
<p class="font-label-md text-label-md text-secondary">Continuités des ravines et corridors de vol nocturnes</p>
</div>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mb-space-md leading-relaxed">
              Diagnostic territorial haute résolution pour reconnecter les réservoirs de biodiversité. Accompagnement spécialisé sur la Trame Noire pour éteindre ou orienter l'éclairage public au profit de l'envol des pétrels de Barau.
            </p>
<div class="grid grid-cols-2 gap-space-sm p-space-sm rounded-DEFAULT bg-surface-container-lowest mb-space-md">
<div>
<div class="font-label-sm text-label-sm text-secondary">Ravines cartographiées</div>
<div class="font-headline-sm text-headline-sm text-primary">312 corridors</div>
</div>
<div>
<div class="font-label-sm text-label-sm text-secondary">Outil fourni</div>
<div class="font-headline-sm text-headline-sm text-surface-tint">Atlas SIG &amp; Recommandations</div>
</div>
</div>
</div>
<div class="flex items-center justify-between pt-space-sm">
<span class="font-label-sm text-label-sm text-on-surface-variant">Public : Aménageurs, Services Techniques</span>
<a class="inline-flex items-center gap-1.5 font-label-lg text-label-lg text-primary hover:text-surface-tint group/link" href="#outils">
<span>Voir le guide Trame</span>
<span class="material-symbols-outlined text-[18px] group-hover/link:translate-x-1 transition-transform">visibility</span>
</a>
</div>
</article>
<!-- Carte D: Génie écologique & Végétalisation péi -->
<article class="dispositif-card flex flex-col justify-between p-space-lg rounded-lg bg-surface-container-low hover:bg-surface-container transition-all group" data-category="collectivite entreprise association">
<div>
<div class="flex items-center justify-between gap-2 mb-space-md">
<span class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-secondary-container text-primary-container font-label-sm text-label-sm uppercase tracking-wider font-bold">
<span class="material-symbols-outlined text-[14px]">local_florist</span>
                100% Espèces Indigènes
              </span>
<span class="font-label-sm text-label-sm text-secondary">Label Végétal Péi</span>
</div>
<div class="flex items-start gap-space-md mb-space-sm">
<div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center text-primary-container flex-shrink-0 group-hover:scale-105 transition-transform">
<span class="material-symbols-outlined text-[26px]">forest</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-primary mb-1">
                  Génie Écologique &amp; Végétalisation Péi
                </h3>
<p class="font-label-md text-label-md text-secondary">Prescriptions techniques pour aménagements urbains</p>
</div>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mb-space-md leading-relaxed">
              Assistance aux maîtres d'ouvrage pour bannir les exotiques envahissantes et privilégier les essences indigènes et endémiques (Bois d'Arnette, Mahot, Benjoin). Suivi des pépinières partenaires labellisées.
            </p>
<div class="grid grid-cols-2 gap-space-sm p-space-sm rounded-DEFAULT bg-surface-container-lowest mb-space-md">
<div>
<div class="font-label-sm text-label-sm text-secondary">Référentiel espèces</div>
<div class="font-headline-sm text-headline-sm text-primary">180 taxons</div>
</div>
<div>
<div class="font-label-sm text-label-sm text-secondary">Pépinières agréées</div>
<div class="font-headline-sm text-headline-sm text-surface-tint">12 sur l'île</div>
</div>
</div>
</div>
<div class="flex items-center justify-between pt-space-sm">
<span class="font-label-sm text-label-sm text-on-surface-variant">Public : Paysagistes, Promoteurs, BTP</span>
<a class="inline-flex items-center gap-1.5 font-label-lg text-label-lg text-primary hover:text-surface-tint group/link" href="#outils">
<span>Consulter la palette végétale</span>
<span class="material-symbols-outlined text-[18px] group-hover/link:translate-x-1 transition-transform">menu_book</span>
</a>
</div>
</article>
</div>
</div>
<!-- Transition Vague SVG 2 (asymétrique inversée) -->
<div aria-hidden="true" class="w-full text-surface-container-high leading-none relative z-10 pt-16">
<svg class="w-full h-16 md:h-24 fill-current block" preserveAspectRatio="none" viewBox="0 0 1440 96">
<path d="M0,64 C360,12 600,92 960,36 C1200,-4 1360,54 1440,78 L1440,96 L0,96 Z"></path>
</svg>
</div>
</section>
<!-- SECTION 3: CARTE DES PROJETS LAURÉATS & RÉALISATIONS SUR L'ÎLE -->
<section class="w-full bg-surface-container-high py-space-xl">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-xl">
<div class="flex flex-col gap-space-xs max-w-2xl">
<div class="inline-flex items-center gap-2 text-secondary font-label-sm text-label-sm uppercase tracking-wider">
<span class="w-2.5 h-2.5 rounded-full bg-surface-tint"></span>
            Cartographie des réalisations péi
          </div>
<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary tracking-tight">
            Sur le terrain : Projets lauréats &amp; impacts mesurés
          </h2>
<p class="font-body-md text-body-md text-on-surface-variant">
            Découvrez comment les financements ARB et l'appui méthodologique transforment concrètement les écosystèmes des 4 micro-régions de La Réunion.
          </p>
</div>
<div class="flex items-center gap-space-xs bg-surface-container-lowest p-1.5 rounded-full shadow-sm">
<button class="px-space-md py-1.5 rounded-full bg-primary text-on-primary font-label-md text-label-md" type="button">Toute l'île</button>
<button class="px-space-md py-1.5 rounded-full text-secondary hover:text-on-surface font-label-md text-label-md transition-colors" type="button">Nord / Ouest</button>
<button class="px-space-md py-1.5 rounded-full text-secondary hover:text-on-surface font-label-md text-label-md transition-colors" type="button">Sud / Est</button>
</div>
</div>
<!-- Grille des 4 Fiches de Réalisations de Terrain -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-md">
<!-- Réalisation 1 : Ravine Saint-Gilles -->
<article class="flex flex-col rounded-lg bg-surface-container-lowest overflow-hidden shadow-sm hover:shadow-md transition-all group">
<div class="relative h-48 w-full overflow-hidden">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="Dense lush tropical river valley in Saint-Gilles Reunion Island, emerald green endemic vegetation, flowing stream, basalt stones, sunlight piercing through ferns and tropical trees, cinematic high resolution photography style" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDZrfyzBJH0No1h1-79EhsgTXIYO-eYMSbc-E-onELVjfzKwk76n1lh2RouNf-PrzRgZDC-9SOUdyIVeZy42IrxkVLWr-Yh5MpRgPWB3gBb7kY2na24GcDwif3yMFh9D2TdoiIFAy7_dBA130YMfXqTi8qYlbzBKjYxxwpY6afPLej3IUZip0gGPdEDl1joAmD_CkOCi2peetj8K65ioXlCvXOIVFEYhUqjCZRoNLC5">
<div class="absolute top-space-xs left-space-xs">
<span class="px-2.5 py-1 rounded-full bg-surface/90 backdrop-blur text-primary font-label-sm text-label-sm font-bold">
                Ouest • Saint-Paul
              </span>
</div>
<div class="absolute bottom-space-xs right-space-xs">
<span class="px-2 py-0.5 rounded-full bg-primary-container text-inverse-on-surface font-label-sm text-label-sm">
                Trame Bleue
              </span>
</div>
</div>
<div class="p-space-md flex flex-col flex-1 justify-between gap-space-md">
<div>
<h3 class="font-headline-sm text-headline-sm text-primary mb-space-xs leading-snug">
                Restauration écologique de la Ravine Saint-Gilles
              </h3>
<p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-3 mb-space-sm">
                Éradication ciblée des lianes papillon et du faux poivrier pour réimplanter 4 200 plants indigènes le long des berges menacées d'érosion.
              </p>
<div class="flex flex-wrap gap-1 mb-space-sm">
<span class="px-2 py-0.5 rounded bg-surface-container text-secondary font-label-sm text-label-sm">Région Réunion</span>
<span class="px-2 py-0.5 rounded bg-surface-container text-secondary font-label-sm text-label-sm">TCO</span>
<span class="px-2 py-0.5 rounded bg-surface-container text-secondary font-label-sm text-label-sm">OFB</span>
