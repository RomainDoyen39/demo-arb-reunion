---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Base title="Observatoire de la biodiversité — ARB Réunion">
  <Header current="biodiversite" />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]"><div class="flex flex-col w-full">
<!-- SECTION 1: HERO IMMERSIF OBSERVATOIRE -->
<section class="page-hero relative w-full text-inverse-on-surface overflow-hidden pt-8 md:pt-16 pb-20 md:pb-28">
<div class="absolute inset-0 opacity-15 pointer-events-none mix-blend-soft-light" style="background-image: radial-gradient(#99d1cb 1px, transparent 1px); background-size: 24px 24px;"></div>
<div class="relative w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin flex flex-col items-center text-center">
<!-- Meta Badge Editorial -->
<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface/10 backdrop-blur-md text-secondary-container font-label-md text-label-md mb-6 shadow-sm">
<span class="w-2 h-2 rounded-full bg-secondary-fixed animate-pulse"></span>
<span>Plateforme Régionale de Données Naturalistes • Borbonica SIG</span>
</div>
<!-- Main Headline -->
<h1 class="font-headline-lg text-[34px] md:text-[52px] lg:text-[60px] leading-[1.1] font-extrabold tracking-tight text-surface max-w-4xl mb-6">
        Observatoire Réunionnais de la Biodiversité
      </h1>
<p class="font-body-lg text-body-lg text-secondary-container max-w-2xl leading-relaxed mb-10 text-balance">
        Centraliser, modéliser et diffuser les connaissances scientifiques sur les écosystèmes volcaniques et coralliens d'exception de l'île de La Réunion.
      </p>
<!-- Barre de recherche augmentée -->
<div class="w-full max-w-2xl mb-12">
<form class="relative flex items-center bg-surface-container-lowest rounded-full p-2 shadow-xl focus-within:shadow-2xl transition-all" id="bio-search">
<div class="pl-4 flex items-center text-secondary">
<span class="material-symbols-outlined text-[24px]">search</span>
</div>
<input class="w-full bg-transparent px-3 py-2.5 text-on-surface font-body-md text-body-md focus:outline-none placeholder:text-on-surface-variant/50 placeholder:text-sm" id="bio-query" placeholder="Rechercher par nom kréol, scientifique ou habitat (ex: Papangue, Tamarins, récif barrière...)" type="search">
<button class="shrink-0 px-6 py-3 rounded-full bg-primary-container text-surface hover:bg-primary font-label-lg text-label-lg transition-colors flex items-center gap-1.5" type="submit">
<span>Explorer</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</button>
</form>
<div class="flex items-center justify-center gap-2 mt-3 text-secondary-container font-label-sm text-label-sm">
<span class="opacity-75">Recherches fréquentes :</span>
<button class="underline decoration-secondary-container/50 hover:text-surface" data-query="Pétrel de Barau" type="button">Pétrel de Barau</button> •
          <button class="underline decoration-secondary-container/50 hover:text-surface" data-query="Mare-Longue" type="button">Forêt de Mare-Longue</button> •
          <button class="underline decoration-secondary-container/50 hover:text-surface" data-query="Gecko vert de Manapany" type="button">Gecko vert de Manapany</button>
</div>
</div>
<!-- Chiffres Clés en Badges Asymétriques -->
<div class="w-full grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 text-left">
<div class="bg-surface/5 backdrop-blur-md rounded-lg p-5 flex flex-col justify-between group hover:bg-surface/10 transition-colors">
<div class="flex items-center justify-between text-secondary-fixed mb-2">
<span class="material-symbols-outlined text-[26px]">potted_plant</span>
<span class="font-label-sm text-label-sm opacity-60">FLORE PÉI</span>
</div>
<div class="font-headline-lg text-headline-lg font-bold text-surface mb-1">1 000+</div>
<div class="font-body-sm text-body-sm text-secondary-container">Espèces végétales indigènes répertoriées</div>
</div>
<div class="bg-surface/5 backdrop-blur-md rounded-lg p-5 flex flex-col justify-between group hover:bg-surface/10 transition-colors">
<div class="flex items-center justify-between text-tertiary-fixed mb-2">
<span class="material-symbols-outlined text-[26px]">fingerprint</span>
<span class="font-label-sm text-label-sm opacity-60">BIOGÉOGRAPHIE</span>
</div>
<div class="font-headline-lg text-headline-lg font-bold text-surface mb-1">33%</div>
<div class="font-body-sm text-body-sm text-secondary-container">Taux d'endémisme strict insulaire</div>
</div>
<div class="bg-surface/5 backdrop-blur-md rounded-lg p-5 flex flex-col justify-between group hover:bg-surface/10 transition-colors">
<div class="flex items-center justify-between text-secondary-fixed mb-2">
<span class="material-symbols-outlined text-[26px]">landscape</span>
<span class="font-label-sm text-label-sm opacity-60">HABITATS CLÉS</span>
</div>
<div class="font-headline-lg text-headline-lg font-bold text-surface mb-1">142</div>
<div class="font-body-sm text-body-sm text-secondary-container">Habitats remarquables patrimoniaux</div>
</div>
<div class="bg-surface/5 backdrop-blur-md rounded-lg p-5 flex flex-col justify-between group hover:bg-surface/10 transition-colors">
<div class="flex items-center justify-between text-secondary-fixed mb-2">
<span class="material-symbols-outlined text-[26px]">insights</span>
<span class="font-label-sm text-label-sm opacity-60">BIG DATA</span>
</div>
<div class="font-headline-lg text-headline-lg font-bold text-surface mb-1">2,4M</div>
<div class="font-body-sm text-body-sm text-secondary-container">Observations mutualisées en libre accès</div>
</div>
</div>
</div>
<!-- Organic wave transition down to Milieux -->
<div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none">
<svg class="w-full h-12 md:h-20 text-surface fill-current" preserveAspectRatio="none" viewBox="0 0 1440 96">
<path d="M0,32 C280,96 520,0 840,48 C1160,96 1360,16 1440,32 L1440,96 L0,96 Z"></path>
</svg>
</div>
</section>
<!-- SECTION 2: EXPLORATION PAR MILIEUX & ÉCOSYSTÈMES -->
<section class="w-full bg-surface pt-16 md:pt-24 pb-0 relative" id="milieux">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<!-- Section Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
<div class="max-w-xl">
<div class="inline-flex items-center gap-2 text-tertiary-container font-label-md text-label-md uppercase tracking-wider mb-2">
<span class="material-symbols-outlined text-[18px]">travel_explore</span>
<span>Typologies Insulaires</span>
</div>
<h2 class="font-headline-lg text-headline-lg text-primary-container font-extrabold tracking-tight">
            Les quatre sanctuaires naturels de l'île
          </h2>
</div>
<p class="font-body-md text-body-md text-on-surface-variant max-w-md">
          Du plancher marin corallien jusqu'aux crêtes d'altitude à plus de 3 000 mètres, suivez l'état dynamique de chaque grand biome réunionnais.
        </p>
</div>
<!-- Grid 4 Milieux -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10" id="habitat-grid">
<!-- Carte 1: Récifs et Lagon -->
<article data-habitat data-keywords="recif lagon corail marin saint-gilles" class="bg-surface-container-low rounded-xl overflow-hidden flex flex-col group hover:shadow-xl transition-all duration-300">
<div class="relative h-64 md:h-72 w-full overflow-hidden">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" data-alt="Photographie sous-marine vibrante d'un récif corallien tropical à La Réunion, lagon turquoise peu profond, coraux branchus Acropora en santé et poissons demoiselles colorés nageant sous une lumière solaire éclatante aux reflets émeraude et vert d'eau." src="https://lh3.googleusercontent.com/aida-public/AB6AXuA7irH_aAPoj8pkEAcwkNhPuUg_7lKLayyoqI1CTMeAOVbL0w878V5wdXJkdzjIETJLk6JLf-cm-qfoGxEnMFxX3d1KWHTRjz2_upV0Jqx1F-1RsEZNU7FRj_ouiGqt4cakWypfo0s0K_MT6Cb3_0MXExug3QCqCb34rpmrM4YFzt3OXOGM53A5cw3ktHeBHFtQmUZhUvPqC-EZkwPatNcURF4R9vBc2n40roixRIjg">
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-black/20"></div>
<div class="absolute top-4 left-4 bg-secondary-container text-primary-container px-3.5 py-1 rounded-full font-label-sm text-label-sm">
              Milieu Marin &amp; Côtier
            </div>
<div class="absolute bottom-4 left-4 right-4 flex items-end justify-between text-surface">
<div>
<h3 class="font-headline-md text-headline-md text-white font-bold leading-tight drop-shadow-sm">Récifs coralliens &amp; Lagon</h3>
<p class="font-body-sm text-body-sm text-secondary-fixed opacity-95">25 km de récifs frangeants sous haute surveillance</p>
</div>
<span class="material-symbols-outlined text-surface-bright text-[28px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
</div>
</div>
<div class="p-6 md:p-8 flex flex-col justify-between flex-1">
<div class="grid grid-cols-3 gap-3 mb-6 pb-6 bg-surface-container-high/40 rounded-lg p-3">
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Recouvrement</span>
<span class="font-headline-sm text-headline-sm text-primary-container font-bold">42,8%</span>
<span class="font-label-sm text-label-sm text-secondary flex items-center gap-0.5"><span class="material-symbols-outlined text-[14px]">arrow_upward</span> Stable</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Surveillance</span>
<span class="font-headline-sm text-headline-sm text-primary-container font-bold">18</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Stations GCRMN</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Résilience</span>
<span class="font-headline-sm text-headline-sm text-tertiary font-bold">Modérée</span>
<span class="font-label-sm text-label-sm text-tertiary-container">Blanchissement '24</span>
</div>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3">
              Suivi scientifique continu des platiers de Saint-Gilles, Saint-Leu et l'Étang-Salé. Analyse de la calcification, du taux d'algues macrophytes et de la recolonisation par les poissons herbivores sentinelles.
            </p>
<div class="flex items-center justify-between pt-4 border-t-0">
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Programme Réserve Marine (RNMR)</span>
<a class="inline-flex items-center gap-1 text-primary-container font-label-lg text-label-lg font-bold group-hover:underline" href="#">
                Dossier complet <span class="material-symbols-outlined text-[16px]">chevron_right</span>
</a>
</div>
</div>
</article>
<!-- Carte 2: Forêts d'altitude -->
<article data-habitat data-keywords="foret mare-longue tamarin altitude parc petrel de barau" class="bg-surface-container-low rounded-xl overflow-hidden flex flex-col group hover:shadow-xl transition-all duration-300">
<div class="relative h-64 md:h-72 w-full overflow-hidden">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" data-alt="Forêt pluviale néphéléphile de montagne à La Réunion, arbres de Tamarins des Hauts couverts d'épiphytes et de mousses humides, nappe de brouillard mystique flottant sur les remparts volcaniques escarpés, tons vert mousse, émeraude sombre et roche basaltique noire." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZ22k61dYcfZMGanVjIREAlLq2E_763WA7Jzk6TJNohrj9KgqNFkIAflRobCzqEsWxg6TJeLMCh8rXN6tgE-Xgw62Vfkmn4MveobNMIDTjEUcuvf-ojX8u3Wyc3E20-UooTDhLNdT6SFMuuYBl46Wfsrht3u_sWcbh02vv9UT2PFCoVv_2kU7N7c7K1xODga3KgSABOrYJ9oC5i8gg-2e0_yrJYxyQjtFIbLPlTzN0">
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-black/20"></div>
<div class="absolute top-4 left-4 bg-secondary-container text-primary-container px-3.5 py-1 rounded-full font-label-sm text-label-sm">
              Cœur de Parc National
            </div>
<div class="absolute bottom-4 left-4 right-4 flex items-end justify-between text-surface">
<div>
<h3 class="font-headline-md text-headline-md text-white font-bold leading-tight drop-shadow-sm">Forêts d'altitude &amp; Pitons</h3>
<p class="font-body-sm text-body-sm text-secondary-fixed opacity-95">Reliques primaires classées Patrimoine Mondial UNESCO</p>
</div>
<span class="material-symbols-outlined text-surface-bright text-[28px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
</div>
</div>
<div class="p-6 md:p-8 flex flex-col justify-between flex-1">
<div class="grid grid-cols-3 gap-3 mb-6 pb-6 bg-surface-container-high/40 rounded-lg p-3">
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Surface Relique</span>
<span class="font-headline-sm text-headline-sm text-primary-container font-bold">100k ha</span>
<span class="font-label-sm text-label-sm text-secondary">40% de l'île</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Intégrité</span>
<span class="font-headline-sm text-headline-sm text-primary-container font-bold">89%</span>
<span class="font-label-sm text-label-sm text-secondary">Peu fragmentée</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Menace EEE</span>
<span class="font-headline-sm text-headline-sm text-tertiary font-bold">Élevée</span>
<span class="font-label-sm text-label-sm text-tertiary-container">Pression goyaviers</span>
</div>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3">
              Les forêts de nuages et maquis d'altitude abritent la plus forte concentration de micro-endémismes du sud-ouest de l'Océan Indien. Contrôle drastique des plantes invasives dans les ravines inaccessibles.
            </p>
<div class="flex items-center justify-between pt-4 border-t-0">
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Suivi ONF &amp; Parc National</span>
<a class="inline-flex items-center gap-1 text-primary-container font-label-lg text-label-lg font-bold group-hover:underline" href="#">
                Dossier complet <span class="material-symbols-outlined text-[16px]">chevron_right</span>
</a>
</div>
</div>
</article>
<!-- Carte 3: Zones Humides et Littoraux -->
<article data-habitat data-keywords="etang littoral zone humide gecko vert de manapany saint-paul" class="bg-surface-container-low rounded-xl overflow-hidden flex flex-col group hover:shadow-xl transition-all duration-300">
<div class="relative h-64 md:h-72 w-full overflow-hidden">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" data-alt="Étang d'eau douce tropical côtier à Saint-Paul La Réunion, miroirs d'eau calmes bordés de roseaux et de papyrus indigènes, oiseaux hérons striés au repos dans une atmosphère vespérale chaude, reflets de sable doré et d'eau sombre." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBQe5fg384r867U41p1UMbKta0go2ZcL33Zt6dpbAlFq5H3HHlJ26sDrsgR7wr-tONKht9W9sQAD5UVuoTp4LvhJxBr1tuGJNA8ot17VS9R4Zg3vgSJ6wbcJ-euSQ6ShBdUmcLHpeqReBkhUrfpU5Q4FHM9QRyc9PMs4qx4dCwHTS2_nqvOf9Aj8mEmas7e4BiN7U7CFEgaPK-SfeusZtv8FF498BID-ynJ58Hphk7i">
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-black/20"></div>
<div class="absolute top-4 left-4 bg-secondary-container text-primary-container px-3.5 py-1 rounded-full font-label-sm text-label-sm">
              Site Ramsar International
            </div>
<div class="absolute bottom-4 left-4 right-4 flex items-end justify-between text-surface">
<div>
<h3 class="font-headline-md text-headline-md text-white font-bold leading-tight drop-shadow-sm">Zones humides &amp; Littoraux</h3>
<p class="font-body-sm text-body-sm text-secondary-fixed opacity-95">Étangs de Saint-Paul et du Gol, ripisylves et salines</p>
</div>
<span class="material-symbols-outlined text-surface-bright text-[28px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
</div>
</div>
<div class="p-6 md:p-8 flex flex-col justify-between flex-1">
<div class="grid grid-cols-3 gap-3 mb-6 pb-6 bg-surface-container-high/40 rounded-lg p-3">
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Surface totale</span>
<span class="font-headline-sm text-headline-sm text-primary-container font-bold">1 200 ha</span>
<span class="font-label-sm text-label-sm text-secondary">Milieux fragiles</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Avifaune</span>
<span class="font-headline-sm text-headline-sm text-primary-container font-bold">48 sp.</span>
<span class="font-label-sm text-label-sm text-secondary">Oiseaux d'eau</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Restauré</span>
<span class="font-headline-sm text-headline-sm text-primary font-bold">+18%</span>
<span class="font-label-sm text-label-sm text-secondary">Depuis 2018</span>
</div>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3">
              Réservoirs d'eau douce indispensables à la reproduction des poissons amphihalins (cabots bouche-ronde) et haltes migratoires pour les limicoles. Gestion active des niveaux d'eau et lutte contre la jussie rampante.
            </p>
<div class="flex items-center justify-between pt-4 border-t-0">
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">RNN Étang de Saint-Paul</span>
<a class="inline-flex items-center gap-1 text-primary-container font-label-lg text-label-lg font-bold group-hover:underline" href="#">
                Dossier complet <span class="material-symbols-outlined text-[16px]">chevron_right</span>
</a>
</div>
</div>
</article>
<!-- Carte 4: Espaces Agricoles & Mi-pentes -->
<article data-habitat data-keywords="agricole ravine trame canne" class="bg-surface-container-low rounded-xl overflow-hidden flex flex-col group hover:shadow-xl transition-all duration-300">
<div class="relative h-64 md:h-72 w-full overflow-hidden">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" data-alt="Paysage vallonné de mi-pentes agricoles à La Réunion, alternance de canne à sucre durable, vergers d'agrumes et haies bocagères indigènes servant de corridors faune, vue plongeante vers l'océan Indien sous un ciel doux d'après-midi, nuances ocre et vert tendre." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBuyQGAP2m0GXlFMgobrVr4RKEuNThoKS2Rxou3i1Lm6_Mtap2_vyMIPirGfgVqCKTpiDw90kQe9XuuuJByVZgV9lFYUhKqw0hx1J131ywkUugqClhjsxmmW2099nIil2Pcz13hV6YLz55-qVxjM2oIc4UvST0LZxlPNxNY0a_DDOzFnx9uUiSYIJ7Kvkn6PdCDN7G45SC5zjg7uqAM-NU1rNY8_0yehvmCSURPztK6">
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-black/20"></div>
<div class="absolute top-4 left-4 bg-secondary-container text-primary-container px-3.5 py-1 rounded-full font-label-sm text-label-sm">
              Trame Verte &amp; Bleue
            </div>
<div class="absolute bottom-4 left-4 right-4 flex items-end justify-between text-surface">
<div>
<h3 class="font-headline-md text-headline-md text-white font-bold leading-tight drop-shadow-sm">Espaces agricoles &amp; Mi-pentes</h3>
<p class="font-body-sm text-body-sm text-secondary-fixed opacity-95">Reconnexion écologique des ravines et agroécologie</p>
</div>
<span class="material-symbols-outlined text-surface-bright text-[28px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
</div>
</div>
<div class="p-6 md:p-8 flex flex-col justify-between flex-1">
<div class="grid grid-cols-3 gap-3 mb-6 pb-6 bg-surface-container-high/40 rounded-lg p-3">
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Ravines connectées</span>
<span class="font-headline-sm text-headline-sm text-primary-container font-bold">310</span>
<span class="font-label-sm text-label-sm text-secondary">Corridors vitaux</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Exploitations</span>
<span class="font-headline-sm text-headline-sm text-primary-container font-bold">240+</span>
<span class="font-label-sm text-label-sm text-secondary">En transition bio</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-on-surface-variant">Haies plantées</span>
<span class="font-headline-sm text-headline-sm text-primary-container font-bold">45 km</span>
<span class="font-label-sm text-label-sm text-secondary">Espèces mellifères</span>
</div>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3">
              Zone tampon stratégique entre les agglomérations littorales et le cœur sauvage de l'île. Mise en place de ripisylves renforcées pour protéger les sols de l'érosion cyclonique et offrir des refuges aux pollinisateurs.
            </p>
<div class="flex items-center justify-between pt-4 border-t-0">
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Programme Ravines Vivantes</span>
<a class="inline-flex items-center gap-1 text-primary-container font-label-lg text-label-lg font-bold group-hover:underline" href="#">
                Dossier complet <span class="material-symbols-outlined text-[16px]">chevron_right</span>
</a>
</div>
</div>
</article>
</div>
</div>
<!-- Organic Wave Asymmetric Transition to Carte -->
<div class="w-full mt-16 md:mt-20 overflow-hidden leading-none text-surface-container-high -mb-px">
<svg class="w-full h-14 md:h-24 fill-current block" preserveAspectRatio="none" viewBox="0 0 1440 96">
<path d="M0,64 C320,16 640,96 1020,32 C1240,8 1380,48 1440,32 L1440,96 L0,96 Z"></path>
</svg>
</div>
</section>
<!-- SECTION 3: CARTE INTERACTIVE DES PRESSIONS ET DE LA DYNAMIQUE -->
<section class="w-full bg-surface-container-high pt-12 md:pt-20 pb-0 relative">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
