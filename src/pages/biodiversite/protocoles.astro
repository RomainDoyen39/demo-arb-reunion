---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { protocoles } from '../../data/protocoles';
---

<Base title="Protocoles simples — Biodiversité ARB Réunion">
  <Header current="biodiversite" />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]">
    <section class="page-hero hero-photo relative overflow-hidden pt-8 pb-24 lg:pb-32" style="--hero-image: url('/images/agenda/atlas-papillons.webp')">
      <div class="max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin relative z-10">
        <nav aria-label="Fil d'Ariane" class="flex flex-wrap items-center gap-1 mb-6 font-label-md text-label-md text-secondary">
          <a class="hover:text-surface transition-colors inline-flex items-center gap-1" href="/">
            <span class="material-symbols-outlined text-[16px]">home</span>
            <span>Accueil</span>
          </a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <a class="hover:text-surface transition-colors" href="/biodiversite">La biodiversité</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="font-semibold">Protocoles simples</span>
        </nav>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-surface-container-lowest text-primary-container font-label-sm text-label-sm">Sciences citoyennes</span>
        <h1 class="max-w-4xl mt-5 font-display-lg text-headline-lg md:text-display-lg text-primary leading-tight">Trois façons simples de transmettre ce que vous voyez</h1>
        <p class="mt-4 max-w-3xl font-body-lg text-body-lg text-secondary">Kap Natir, Kélonia Photo et Vigie Papillons nourrissent la base Borbonica. Une photo et un lieu suffisent pour lancer la relecture.</p>
      </div>
      <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none">
        <svg class="w-full h-12 md:h-20 text-surface fill-current block" preserveAspectRatio="none" viewBox="0 -16 1440 112">
          <path d="M0,32 C280,96 520,0 840,48 C1160,96 1360,16 1440,32 L1440,96 L0,96 Z"></path>
        </svg>
      </div>
    </section>

    <section class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin pt-4 pb-16">
      <ul class="grid grid-cols-1 gap-6 p-0 list-none">
        {protocoles.map((protocole) => (
          <li id={protocole.id} class="scroll-mt-28 grid grid-cols-1 lg:grid-cols-12 gap-0 overflow-hidden rounded-xl bg-surface-container-lowest shadow-sm">
            <div class="lg:col-span-4 min-h-52 bg-cover bg-center" style={`background-image: url('${protocole.image}')`}></div>
            <div class="lg:col-span-8 p-6 md:p-8">
              <p class="inline-flex items-center gap-2 font-label-sm text-label-sm text-primary-container">
                <span class="material-symbols-outlined text-[18px]">{protocole.icon}</span>
                {protocole.name}
              </p>
              <h2 class="mt-2 font-headline-sm text-headline-sm text-primary">{protocole.tagline}</h2>
              <p class="mt-3 font-body-md text-body-md text-secondary leading-relaxed">{protocole.summary}</p>
              <ol class="mt-5 flex flex-col gap-2 p-0 list-none">
                {protocole.steps.map((step, index) => (
                  <li class="flex items-start gap-3 font-body-sm text-body-sm text-on-surface">
                    <span class="mt-0.5 inline-flex w-6 h-6 shrink-0 items-center justify-center rounded-full bg-secondary-container text-primary-container font-label-sm text-label-sm">{index + 1}</span>
                    <span>{step}</span>
                  </li>
                ))}
              </ol>
              <a class="mt-6 inline-flex items-center justify-center gap-2 min-h-[44px] px-5 rounded-full bg-primary-container text-surface font-label-md text-label-md hover:bg-primary" href={`/biodiversite/observation?programme=${protocole.id}`}>
                <span class="material-symbols-outlined text-[18px]">upload_file</span>
                Transmettre selon ce protocole
              </a>
            </div>
          </li>
        ))}
      </ul>
      <a class="mt-8 inline-flex items-center gap-1 font-label-md text-label-md text-secondary hover:text-primary" href="/biodiversite">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        Retour à l'observatoire
      </a>
    </section>
  </main>
  <Footer />
</Base>
