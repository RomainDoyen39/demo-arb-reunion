---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { protocoles } from '../../data/protocoles';
---

<Base title="Transmettre une observation — Biodiversité ARB Réunion">
  <Header current="biodiversite" />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]">
    <section class="page-hero hero-photo relative overflow-hidden pt-8 pb-24 lg:pb-32" style="--hero-image: url('/images/bandeaux/saint-leu.webp')">
      <div class="max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin relative z-10">
        <nav aria-label="Fil d'Ariane" class="flex flex-wrap items-center gap-1 mb-6 font-label-md text-label-md text-secondary">
          <a class="hover:text-surface transition-colors inline-flex items-center gap-1" href="/">
            <span class="material-symbols-outlined text-[16px]">home</span>
            <span>Accueil</span>
          </a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <a class="hover:text-surface transition-colors" href="/biodiversite">La biodiversité</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="font-semibold">Transmettre une observation</span>
        </nav>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-surface-container-lowest text-primary-container font-label-sm text-label-sm">Borbonica</span>
        <h1 class="max-w-4xl mt-5 font-display-lg text-headline-lg md:text-display-lg text-primary leading-tight">Transmettre une observation</h1>
        <p class="mt-4 max-w-3xl font-body-lg text-body-lg text-secondary">Une photo, un lieu et le protocole choisi. Les naturalistes du réseau relisent le signalement avant de l'ajouter à la base.</p>
      </div>
      <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none">
        <svg class="w-full h-12 md:h-20 text-surface fill-current block" preserveAspectRatio="none" viewBox="0 -16 1440 112">
          <path d="M0,32 C280,96 520,0 840,48 C1160,96 1360,16 1440,32 L1440,96 L0,96 Z"></path>
        </svg>
      </div>
    </section>

    <section class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin pt-4 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <form class="lg:col-span-7 bg-surface-container-lowest rounded-xl p-6 md:p-8 shadow-sm flex flex-col gap-5" id="observation-form">
          <div hidden class="p-4 rounded-xl bg-secondary-container text-primary-container font-label-md text-label-md flex items-start gap-2" id="observation-success" role="status">
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span id="observation-success-text"></span>
          </div>

          <div>
            <label class="block font-label-md text-label-md text-primary-container font-bold mb-2" for="programme">
              Protocole <span class="text-tertiary">*</span>
            </label>
            <select class="w-full px-4 py-3 rounded-xl bg-surface font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary" id="programme" name="programme" required>
              {protocoles.map((protocole) => (
                <option value={protocole.id}>{protocole.name} — {protocole.tagline}</option>
              ))}
            </select>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block font-label-md text-label-md text-primary-container font-bold mb-2" for="lieu">
                Commune ou lieu-dit <span class="text-tertiary">*</span>
              </label>
              <input class="w-full px-4 py-3 rounded-xl bg-surface font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:ring-2 focus:ring-primary" id="lieu" name="lieu" placeholder="ex. Saint-Leu, pointe au Sel" required type="text">
            </div>
            <div>
              <label class="block font-label-md text-label-md text-primary-container font-bold mb-2" for="date">
                Date <span class="text-tertiary">*</span>
              </label>
              <input class="w-full px-4 py-3 rounded-xl bg-surface font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary" id="date" name="date" required type="date">
            </div>
          </div>

          <div>
            <label class="block font-label-md text-label-md text-primary-container font-bold mb-2" for="description">
              Ce que vous avez vu <span class="text-tertiary">*</span>
            </label>
            <textarea class="w-full px-4 py-3 rounded-xl bg-surface font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:ring-2 focus:ring-primary resize-y" id="description" name="description" placeholder="Espèce supposée, nombre d'individus, comportement, milieu autour de vous." required rows="5"></textarea>
          </div>

          <div>
            <label class="block font-label-md text-label-md text-primary-container font-bold mb-2" for="email">
              E-mail <span class="text-tertiary">*</span>
            </label>
            <input class="w-full px-4 py-3 rounded-xl bg-surface font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:ring-2 focus:ring-primary" id="email" name="email" placeholder="nom@exemple.re" required type="email">
          </div>

          <div class="p-4 rounded-xl bg-surface flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <span class="material-symbols-outlined text-[24px] text-secondary">add_a_photo</span>
              <div class="min-w-0">
                <span class="font-semibold text-on-surface block">Photo</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant" id="photo-name">JPG ou PNG, une vue nette suffit.</span>
              </div>
            </div>
            <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-variant text-on-surface font-label-sm text-label-sm shrink-0">
              Choisir une photo
              <input accept="image/*" class="sr-only" id="photo" name="photo" type="file">
            </label>
          </div>

          <div class="flex items-start gap-3">
            <input class="mt-1 w-4 h-4 rounded text-primary-container focus:ring-primary" id="consent" name="consent" required type="checkbox">
            <label class="font-body-sm text-body-sm text-on-surface-variant" for="consent">
              J'accepte que ces informations soient utilisées par l'Agence pour relire mon observation. <a class="text-primary-container underline hover:text-primary" href="/mentions/confidentialite">Politique de confidentialité</a>.
            </label>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <p class="font-label-sm text-label-sm text-secondary">Relecture sous quelques jours, avant intégration à Borbonica.</p>
            <button class="inline-flex items-center justify-center gap-2 min-h-[44px] px-6 rounded-full bg-primary-container text-surface hover:bg-primary font-label-lg text-label-lg" type="submit">
              Transmettre
              <span class="material-symbols-outlined text-[18px]">send</span>
            </button>
          </div>
        </form>

        <aside class="lg:col-span-5 lg:sticky lg:top-24 rounded-xl bg-surface-container-low p-6">
          <h2 class="font-headline-sm text-headline-sm text-primary">Avant d'envoyer</h2>
          <ul class="mt-4 flex flex-col gap-3 p-0 list-none">
            <li class="flex items-start gap-3 font-body-sm text-body-sm text-secondary">
              <span class="material-symbols-outlined text-[20px] text-primary-container">photo_camera</span>
              <span>Une photo nette vaut mieux qu'une longue description.</span>
            </li>
            <li class="flex items-start gap-3 font-body-sm text-body-sm text-secondary">
              <span class="material-symbols-outlined text-[20px] text-primary-container">do_not_touch</span>
              <span>On n'approche pas, on ne prélève pas, on ne déplace pas.</span>
            </li>
            <li class="flex items-start gap-3 font-body-sm text-body-sm text-secondary">
              <span class="material-symbols-outlined text-[20px] text-primary-container">fact_check</span>
              <span>Un naturaliste du protocole choisi relit chaque envoi.</span>
            </li>
          </ul>
          <a class="mt-6 inline-flex items-center gap-1 font-label-md text-label-md font-semibold text-primary-container" href="/biodiversite/protocoles">
            <span>Découvrir les protocoles simples</span>
            <span class="material-symbols-outlined text-[18px]">chevron_right</span>
          </a>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  const form = document.getElementById('observation-form');
  const programme = document.getElementById('programme');
  const photo = document.getElementById('photo');
  const photoName = document.getElementById('photo-name');
  const success = document.getElementById('observation-success');
  const successText = document.getElementById('observation-success-text');
  const date = document.getElementById('date');

  if (date instanceof HTMLInputElement) {
    date.max = new Date().toISOString().slice(0, 10);
  }

  const wanted = new URLSearchParams(location.search).get('programme');
  if (programme instanceof HTMLSelectElement && wanted && [...programme.options].some((option) => option.value === wanted)) {
    programme.value = wanted;
  }

  photo?.addEventListener('change', () => {
    const file = photo instanceof HTMLInputElement ? photo.files?.[0] : null;
    if (photoName) photoName.textContent = file ? file.name : 'JPG ou PNG, une vue nette suffit.';
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(programme instanceof HTMLSelectElement)) return;
    const lieu = new FormData(form).get('lieu');
    const label = programme.selectedOptions[0]?.textContent?.split('—')[0]?.trim() || 'le programme choisi';
    const file = photo instanceof HTMLInputElement ? photo.files?.[0] : null;
    if (successText) {
      successText.textContent = file
        ? `Merci. Votre observation à ${lieu} est transmise pour ${label}, avec la photo « ${file.name} ». Un naturaliste la relit avant intégration à Borbonica.`
        : `Merci. Votre observation à ${lieu} est transmise pour ${label}. Un naturaliste la relit avant intégration à Borbonica.`;
    }
    if (success) success.hidden = false;
    form.reset();
    if (photoName) photoName.textContent = 'JPG ou PNG, une vue nette suffit.';
    success?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
