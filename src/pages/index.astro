---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="ARB Réunion — La biodiversité de l’île">
  <Header />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]"><div class="flex flex-col w-full text-on-surface">
<!-- TOP HERO AMBIENT CONTAINER -->
<section class="page-hero relative w-full overflow-hidden py-space-lg lg:py-space-xl">
<div class="relative w-full max-w-[1280px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg lg:gap-space-xl items-center">
<!-- Left Editorial Column (7 cols) -->
<div class="lg:col-span-7 flex flex-col items-start">
<div class="inline-flex items-center gap-2 mb-space-sm px-space-xs py-1 rounded-full bg-surface-container-high text-secondary">
<span class="w-2 h-2 rounded-full bg-primary-container"></span>
<span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant">La Réunion • Agence Régionale de la Biodiversité</span>
</div>
<h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary-container tracking-tight leading-[1.08] mb-space-md font-bold">
            La biodiversité de l’île,<br>
<span class="italic text-primary">et le chemin</span><br>
            pour agir.
          </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-[560px] leading-relaxed mb-space-lg">
            L’ARB relie les structures de terrain, les habitants et les décideurs. Comprendre, trouver un acteur, un rendez-vous, une ressource ou un financement.
          </p>
<div class="flex flex-wrap items-center gap-space-md">
<a class="inline-flex items-center justify-center min-h-[48px] px-8 py-3.5 rounded-full bg-primary-container text-inverse-on-surface font-label-lg text-label-lg transition-all duration-200 hover:bg-primary shadow-[0_8px_24px_rgba(17,78,74,0.18)] focus:outline-none focus:ring-2 focus:ring-primary-container focus:ring-offset-2" data-path="actions" href="/biodiversite">
              Explorer les actions
            </a>
<a class="inline-flex items-center gap-3 min-h-[48px] px-6 py-3.5 rounded-full bg-surface-container-lowest text-primary-container font-label-lg text-label-lg transition-all duration-200 hover:bg-surface-container shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-container focus:ring-offset-2" data-path="agenda" href="/agenda">
<span class="w-7 h-7 rounded-full bg-secondary-container flex items-center justify-center text-primary-container">
<span class="material-symbols-outlined text-[16px]">arrow_forward</span>
</span>
<span>Voir l’agenda</span>
</a>
</div>
<!-- Micro indicator meta note -->
<div class="mt-space-lg pt-space-md flex items-center gap-4 text-secondary font-label-sm text-label-sm">
<span class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-primary-container">verified</span>
              Portail public de l'État &amp; Région Réunion
            </span>
<span class="text-outline-variant">•</span>
<span>Mise à jour quotidienne</span>
</div>
</div>
<!-- Right Visual Showcase Column (5 cols) -->
<div class="lg:col-span-5 flex flex-col gap-space-md">
<!-- Featured Protected Landscape Crop with Organic Framing -->
<div class="relative w-full rounded-[32px] overflow-hidden p-2 bg-gradient-to-b from-surface-variant/80 to-secondary-container/50 shadow-md">
<div class="relative w-full h-[280px] sm:h-[320px] rounded-[26px] overflow-hidden bg-surface-container">
<img alt="Paysage spectaculaire du cirque et du lagon de l'île de La Réunion" class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBWrpYwKHFrsEP1wbNUiTGp5RNiU2U_Zor-9I7uRQYQ7X_t-uAabpfC9Mdc_gWklEeUkxO7sKH42NNf8_hK2fcrfvnBp-9zNbDBttIQ1tu-Hwrcv-FyTG3-qHD1v-AvlidYiV9VCmCXqEvFx7zFw1g2k9QtOkLsQJs2TI2jgmeR5BbleIqFs3U3pyaELio11YwnQUVH8NDU_ZnMm1UDRta1kN8Lke4G85NHues8ZOA-">
<div class="absolute inset-0 bg-gradient-to-t from-primary-container/60 via-transparent to-transparent"></div>
<div class="absolute bottom-4 left-5 right-5 flex items-center justify-between text-inverse-on-surface">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-[18px]">photo_camera</span>
<span class="font-label-sm text-label-sm tracking-wide">Du sommet des pitons aux barrières coralliennes</span>
</div>
<span class="px-2.5 py-0.5 rounded-full bg-primary-container/80 backdrop-blur-sm text-inverse-on-surface font-label-sm text-label-sm">UNESCO</span>
</div>
</div>
</div>
<!-- 3 Distinct Grounding Cards (Non-overlapping, editorial paper finish) -->
<div class="flex flex-col gap-3" style="--hero-card-shadow: 0 4px 20px -2px rgba(17,78,74,0.08), 0 2px 6px -1px rgba(0,0,0,0.04);">
<!-- Card 1: Prochain Chantier -->
<a class="group flex items-center justify-between p-4 sm:p-5 rounded-[24px] bg-surface-container-lowest shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:bg-surface-container transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-container" data-path="agenda" href="/agenda" style="background-color: rgb(255, 255, 255); border: 1px solid rgba(17, 78, 74, 0.15); box-shadow: rgba(17, 78, 74, 0.08) 0px 4px 20px -2px, rgba(0, 0, 0, 0.04) 0px 2px 6px -1px;">
<div class="flex items-start gap-3.5">
<div class="w-10 h-10 rounded-2xl bg-secondary-container flex items-center justify-center text-primary-container mt-0.5">
<span class="material-symbols-outlined text-[20px]">calendar_month</span>
</div>
<div class="flex flex-col">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary">Prochain chantier</span>
<span class="font-headline-sm text-headline-sm text-primary-container group-hover:text-primary transition-colors">Plantation à Cilaos</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">12 avril • matin • Reboisement endémique</span>
</div>
</div>
<div class="flex items-center text-primary font-label-md text-label-md group-hover:translate-x-1 transition-transform">
<span>S'inscrire</span>
<span class="material-symbols-outlined text-[18px] ml-1">arrow_forward</span>
</div>
</a>
<!-- Card 2: Chiffre Clé -->
<div class="flex items-center justify-between p-4 sm:p-5 rounded-[24px] bg-surface-container-lowest shadow-[0_4px_20px_rgba(0,0,0,0.03)]" style="background-color: rgb(255, 255, 255); border: 1px solid rgba(17, 78, 74, 0.15); box-shadow: rgba(17, 78, 74, 0.08) 0px 4px 20px -2px, rgba(0, 0, 0, 0.04) 0px 2px 6px -1px;">
<div class="flex items-start gap-3.5">
<div class="w-10 h-10 rounded-2xl bg-surface-container-high flex items-center justify-center text-primary-container mt-0.5">
<span class="material-symbols-outlined text-[20px]">diversity_3</span>
</div>
<div class="flex flex-col">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary">Chiffre clé</span>
<span class="font-headline-sm text-headline-sm text-primary-container">Près de 100 structures</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">dans l’annuaire des acteurs régionaux</span>
</div>
</div>
<a class="px-3.5 py-1.5 rounded-full bg-secondary-container text-primary-container hover:bg-secondary hover:text-on-secondary font-label-sm text-label-sm transition-colors" data-path="annuaire" href="/annuaire">Consulter</a>
</div>
<!-- Card 3: Dispositif -->
<a class="group flex items-center justify-between p-4 sm:p-5 rounded-[24px] bg-surface-container-lowest shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:bg-surface-container transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-container" data-path="ten" href="/accompagnement" style="background-color: rgb(255, 255, 255); border: 1px solid rgba(17, 78, 74, 0.15); box-shadow: rgba(17, 78, 74, 0.08) 0px 4px 20px -2px, rgba(0, 0, 0, 0.04) 0px 2px 6px -1px;">
<div class="flex items-start gap-3.5">
<div class="w-10 h-10 rounded-2xl bg-secondary-container flex items-center justify-center text-primary-container mt-0.5">
<span class="material-symbols-outlined text-[20px]">psychiatry</span>
</div>
<div class="flex flex-col">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-tertiary">Dispositif régional</span>
<span class="font-headline-sm text-headline-sm text-primary-container">Territoires engagés pour la nature</span>
<span class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1.5 mt-0.5">
<span class="inline-block w-2 h-2 rounded-full bg-secondary"></span>
                    Accompagnement communal et intercommunal
                  </span>
</div>
</div>
<span class="material-symbols-outlined text-primary-container group-hover:translate-x-1 transition-transform">chevron_right</span>
</a>
</div>
</div>
</div>
</div>
<div aria-hidden="true" class="w-full overflow-hidden leading-none pointer-events-none mt-space-lg -mb-space-lg lg:-mb-space-xl"><svg class="w-full h-16 md:h-[88px] text-surface-container-low fill-current block" preserveAspectRatio="none" viewBox="0 0 1440 88"><path d="M0,32 C260,86 520,6 820,54 C1120,96 1300,16 1440,58 L1440,88 L0,88 Z"></path></svg></div></section>
<!-- SECTION 2: TROIS FAÇONS D'ENTRER (Audience Orientations) -->
<section class="w-full bg-surface-container-low py-space-xl">
<div class="w-full max-w-[1280px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-lg gap-space-sm">
<div>
<span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary block mb-1">Orientation par public</span>
<h2 class="font-headline-lg text-headline-lg text-primary-container font-bold">Trois façons d’entrer</h2>
</div>
<p class="font-body-md text-body-md text-on-surface-variant max-w-[420px]">
          Que vous portiez un projet de conservation, souhaitiez agir le week-end ou votiez les budgets territoriaux.
        </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-space-md lg:gap-space-lg">
<!-- Card A: Pour les structures -->
<a class="group flex flex-col justify-between p-space-lg rounded-[28px] bg-secondary-container/40 hover:bg-secondary-container/60 transition-all duration-300 shadow-[0_8px_24px_rgba(0,0,0,0.02)] hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary-container min-h-[320px]" data-path="espace-structures" href="/annuaire" style="background-color: rgb(255, 255, 255); border: 1.5px solid rgb(208, 232, 226); box-shadow: rgba(17, 78, 74, 0.09) 0px 8px 24px -4px, rgba(0, 0, 0, 0.04) 0px 2px 8px -1px;">
<div>
<div class="w-12 h-12 rounded-2xl bg-surface-container-lowest text-primary-container flex items-center justify-center mb-space-md group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-[26px]">hub</span>
</div>
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold block mb-1">Pour les structures</span>
<h3 class="font-headline-md text-headline-md text-primary-container mb-space-xs leading-snug">Acteurs de la biodiversité</h3>
<p class="font-body-md text-body-md text-on-surface-variant">Valoriser vos actions, mutualiser le matériel scientifique et trouver les autres structures de terrain.</p>
</div>
<div class="pt-space-md mt-space-md flex items-center gap-2 font-label-lg text-label-lg text-primary-container group-hover:text-primary">
<span>Accéder à l'espace acteur</span>
<span class="material-symbols-outlined text-[18px] group-hover:translate-x-1.5 transition-transform">arrow_forward</span>
</div>
</a>
<!-- Card B: Pour les citoyens -->
<a class="group flex flex-col justify-between p-space-lg rounded-[28px] bg-surface-container-high hover:bg-surface-variant transition-all duration-300 shadow-[0_8px_24px_rgba(0,0,0,0.02)] hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary-container min-h-[320px]" data-path="espace-citoyens" href="/agenda" style="background-color: rgb(255, 255, 255); border: 1.5px solid rgb(226, 218, 200); box-shadow: rgba(17, 78, 74, 0.09) 0px 8px 24px -4px, rgba(0, 0, 0, 0.04) 0px 2px 8px -1px;">
<div>
<div class="w-12 h-12 rounded-2xl bg-surface-container-lowest text-primary-container flex items-center justify-center mb-space-md group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-[26px]">footprint</span>
</div>
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold block mb-1">Pour les citoyens</span>
<h3 class="font-headline-md text-headline-md text-primary-container mb-space-xs leading-snug">Habitants</h3>
<p class="font-body-md text-body-md text-on-surface-variant">Chantiers participatifs, sorties guidées et outils simples pour agir concrètement près de chez vous.</p>
</div>
<div class="pt-space-md mt-space-md flex items-center gap-2 font-label-lg text-label-lg text-primary-container group-hover:text-primary">
<span>Découvrir les initiatives</span>
<span class="material-symbols-outlined text-[18px] group-hover:translate-x-1.5 transition-transform">arrow_forward</span>
</div>
</a>
<!-- Card C: Pour les collectivités & entreprises -->
<a class="group flex flex-col justify-between p-space-lg rounded-[28px] bg-tertiary-fixed/30 hover:bg-tertiary-fixed/50 transition-all duration-300 shadow-[0_8px_24px_rgba(0,0,0,0.02)] hover:shadow-md focus:outline-none focus:ring-2 focus:ring-tertiary-container min-h-[320px]" data-path="espace-decideurs" href="/accompagnement" style="background-color: rgb(255, 255, 255); border: 1.5px solid rgb(255, 219, 209); box-shadow: rgba(121, 46, 22, 0.09) 0px 8px 24px -4px, rgba(0, 0, 0, 0.04) 0px 2px 8px -1px;">
<div>
<div class="w-12 h-12 rounded-2xl bg-surface-container-lowest text-tertiary-container flex items-center justify-center mb-space-md group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-[26px]">account_balance</span>
</div>
<span class="font-label-sm text-label-sm uppercase tracking-wider text-tertiary font-bold block mb-1">Pour les collectivités &amp; entreprises</span>
<h3 class="font-headline-md text-headline-md text-primary-container mb-space-xs leading-snug">Décideurs et entreprises</h3>
<p class="font-body-md text-body-md text-on-surface-variant">TEN, EEN, indicateurs écologiques et guides de commande publique pour s’engager à l'échelle péi.</p>
</div>
<div class="pt-space-md mt-space-md flex items-center gap-2 font-label-lg text-label-lg text-tertiary-container group-hover:text-tertiary">
<span>Consulter les dispositifs</span>
<span class="material-symbols-outlined text-[18px] group-hover:translate-x-1.5 transition-transform">arrow_forward</span>
</div>
</a>
</div>
</div>
<div aria-hidden="true" class="w-full overflow-hidden leading-none pointer-events-none mt-space-lg -mb-space-xl"><svg class="w-full h-8 md:h-12 text-surface fill-current block" preserveAspectRatio="none" viewBox="0 0 1440 48"><path d="M0,28 C300,6 540,44 860,18 C1140,-4 1320,38 1440,24 L1440,48 L0,48 Z"></path></svg></div></section>
<!-- SECTION 3: QUATRE PORTES (Missions & Services ARB) -->
<section class="w-full bg-surface py-space-xl">
<div class="w-full max-w-[1280px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<div class="mb-space-lg">
<span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary block mb-1">Les missions et services de l'ARB</span>
<h2 class="font-headline-lg text-headline-lg text-primary-container font-bold">Quatre portes</h2>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
<!-- Porte 1: Fédérer -->
<a class="group flex flex-col justify-between p-space-md rounded-[24px] bg-surface-container-lowest shadow-sm hover:shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-container min-h-[260px]" data-path="annuaire" href="/annuaire" style="background-color: rgb(255, 255, 255); border: 1px solid rgb(217, 210, 194); box-shadow: rgba(17, 78, 74, 0.06) 0px 4px 16px -2px, rgba(0, 0, 0, 0.04) 0px 2px 6px -1px;">
<div>
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-secondary px-2.5 py-1 rounded-full bg-surface-container">Fédérer</span>
<span class="material-symbols-outlined text-secondary group-hover:text-primary-container group-hover:translate-x-1 transition-all">north_east</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-primary-container mb-2 group-hover:text-primary transition-colors">Annuaire</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Recenser, cartographier et connecter tous les acteurs et experts naturalistes de l'île.</p>
</div>
<div class="mt-4 pt-3 flex items-center gap-2 text-label-sm font-label-sm text-secondary group-hover:text-primary-container">
<span class="material-symbols-outlined text-[16px]">map</span>
<span>98 acteurs référencés</span>
</div>
</a>
<!-- Porte 2: Mobiliser -->
<a class="group flex flex-col justify-between p-space-md rounded-[24px] bg-surface-container-lowest shadow-sm hover:shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-container min-h-[260px]" data-path="agenda" href="/agenda" style="background-color: rgb(255, 255, 255); border: 1px solid rgb(217, 210, 194); box-shadow: rgba(17, 78, 74, 0.06) 0px 4px 16px -2px, rgba(0, 0, 0, 0.04) 0px 2px 6px -1px;">
<div>
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-secondary px-2.5 py-1 rounded-full bg-surface-container">Mobiliser</span>
<span class="material-symbols-outlined text-secondary group-hover:text-primary-container group-hover:translate-x-1 transition-all">north_east</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-primary-container mb-2 group-hover:text-primary transition-colors">Agenda</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Les chantiers participatifs, colloques scientifiques et sorties découverte nature à La Réunion.</p>
</div>
<div class="mt-4 pt-3 flex items-center gap-2 text-label-sm font-label-sm text-secondary group-hover:text-primary-container">
<span class="material-symbols-outlined text-[16px]">event</span>
<span>24 dates à venir</span>
</div>
</a>
<!-- Porte 3: Outiller -->
<a class="group flex flex-col justify-between p-space-md rounded-[24px] bg-surface-container-lowest shadow-sm hover:shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-container min-h-[260px]" data-path="ressources" href="/ressources" style="background-color: rgb(255, 255, 255); border: 1px solid rgb(217, 210, 194); box-shadow: rgba(17, 78, 74, 0.06) 0px 4px 16px -2px, rgba(0, 0, 0, 0.04) 0px 2px 6px -1px;">
<div>
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-secondary px-2.5 py-1 rounded-full bg-surface-container">Outiller</span>
<span class="material-symbols-outlined text-secondary group-hover:text-primary-container group-hover:translate-x-1 transition-all">north_east</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-primary-container mb-2 group-hover:text-primary transition-colors">Ressources</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Guides méthodologiques, fiches espèces menacées et retours d'expériences de terrain.</p>
</div>
<div class="mt-4 pt-3 flex items-center gap-2 text-label-sm font-label-sm text-secondary group-hover:text-primary-container">
<span class="material-symbols-outlined text-[16px]">menu_book</span>
<span>140+ publications en accès libre</span>
</div>
</a>
<!-- Porte 4: Accompagner -->
<a class="group flex flex-col justify-between p-space-md rounded-[24px] bg-surface-container-lowest shadow-sm hover:shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-container min-h-[260px]" data-path="financements" href="/accompagnement" style="background-color: rgb(255, 255, 255); border: 1px solid rgb(217, 210, 194); box-shadow: rgba(17, 78, 74, 0.06) 0px 4px 16px -2px, rgba(0, 0, 0, 0.04) 0px 2px 6px -1px;">
<div>
<div class="flex items-center justify-between mb-space-md">
<span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-secondary px-2.5 py-1 rounded-full bg-surface-container">Accompagner</span>
<span class="material-symbols-outlined text-secondary group-hover:text-primary-container group-hover:translate-x-1 transition-all">north_east</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-primary-container mb-2 group-hover:text-primary transition-colors">Financements</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Appels à projets, subventions et aides pour la restauration écologique des milieux réunionnais.</p>
</div>
<div class="mt-4 pt-3 flex items-center gap-2 text-label-sm font-label-sm text-secondary group-hover:text-primary-container">
<span class="material-symbols-outlined text-[16px]">payments</span>
<span>3 appels en cours</span>
</div>
</a>
</div>
</div>
<div aria-hidden="true" class="w-full overflow-hidden leading-none pointer-events-none mt-space-lg -mb-space-xl"><svg class="w-full h-16 md:h-[92px] text-surface-container-low fill-current block" preserveAspectRatio="none" viewBox="0 0 1440 92"><path d="M0,28 C280,82 580,10 880,64 C1160,104 1320,18 1440,52 L1440,92 L0,92 Z"></path></svg></div></section>
<!-- SECTION 4: ACTUALITÉS & RENDEZ-VOUS (Split Layout) -->
<section class="w-full bg-surface-container-low py-space-xl">
<div class="w-full max-w-[1280px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-lg gap-space-sm">
<div>
<span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary block mb-1">Dynamique régionale</span>
<h2 class="font-headline-lg text-headline-lg text-primary-container font-bold">Actualités &amp; Rendez-vous</h2>
</div>
<div class="flex items-center gap-space-sm">
<a class="font-label-lg text-label-lg text-primary-container hover:text-primary inline-flex items-center gap-1" data-path="actualites" href="/agenda">
<span>Tous les articles</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</div>
</div>
