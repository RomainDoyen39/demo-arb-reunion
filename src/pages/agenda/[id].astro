---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { agenda } from '../../data/agenda';

export function getStaticPaths() {
  return agenda.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const autres = [...agenda]
  .filter((entry) => entry.id !== item.id)
  .sort((a, b) => Number(b.kind === item.kind) - Number(a.kind === item.kind))
  .slice(0, 3);
const mailto = `mailto:agenda@arb-reunion.fr?subject=${encodeURIComponent(item.title)}`;
---

<Base title={`${item.title} — Agenda ARB Réunion`}>
  <Header current="agenda" />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]">
    <section class="page-hero hero-photo relative overflow-hidden pt-8 pb-24 lg:pb-32" style={`--hero-image: url('${item.image}')`}>
      <div class="max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin relative z-10">
        <nav aria-label="Fil d'Ariane" class="flex flex-wrap items-center gap-1 mb-6 font-label-md text-label-md text-secondary">
          <a class="hover:text-surface transition-colors inline-flex items-center gap-1" href="/">
            <span class="material-symbols-outlined text-[16px]">home</span>
            <span>Accueil</span>
          </a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <a class="hover:text-surface transition-colors" href="/agenda">Agenda</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="font-semibold">{item.kindLabel}</span>
        </nav>
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-surface-container-lowest text-primary-container font-label-sm text-label-sm">{item.category}</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-surface-container-lowest text-primary-container font-label-sm text-label-sm">
            <span class="material-symbols-outlined text-[16px]">calendar_month</span>
            {item.dateLabel}
          </span>
        </div>
        <h1 class="max-w-4xl font-display-lg text-headline-lg md:text-display-lg text-primary leading-tight">{item.title}</h1>
        <p class="mt-4 inline-flex items-center gap-1 font-label-md text-label-md text-secondary">
          <span class="material-symbols-outlined text-[18px]">location_on</span>
          <span>{item.place}</span>
        </p>
      </div>
      <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none">
        <svg class="w-full h-12 md:h-20 text-surface fill-current block" preserveAspectRatio="none" viewBox="0 -16 1440 112">
          <path d="M0,32 C280,96 520,0 840,48 C1160,96 1360,16 1440,32 L1440,96 L0,96 Z"></path>
        </svg>
      </div>
    </section>

    <section class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin pt-4 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8">
          <p class="font-body-lg text-body-lg text-on-surface leading-relaxed">{item.excerpt}</p>
          {item.paragraphs.map((paragraph) => (
            <p class="mt-4 font-body-md text-body-md text-secondary leading-relaxed">{paragraph}</p>
          ))}
        </div>

        <aside class="lg:col-span-4 lg:sticky lg:top-24 rounded-lg bg-surface-container-lowest p-6 shadow-sm">
          <p class="font-label-sm text-label-sm text-secondary">{item.kindLabel}</p>
          <h2 class="mt-2 font-headline-sm text-headline-sm text-primary">En bref</h2>
          <ul class="mt-4 flex flex-col gap-3 p-0 list-none">
            {item.facts.map((fact) => (
              <li>
                <p class="font-label-sm text-label-sm text-secondary">{fact.label}</p>
                <p class="font-label-md text-label-md font-bold text-primary-container">{fact.value}</p>
              </li>
            ))}
          </ul>
          <div class="mt-6 flex flex-col gap-2">
            {item.cta && (
              <a class="inline-flex items-center justify-center gap-2 min-h-[44px] px-4 rounded-full bg-primary-container text-inverse-on-surface font-label-md text-label-md hover:bg-primary" href={mailto}>
                {item.cta}
              </a>
            )}
            <a class="inline-flex items-center justify-center gap-1 min-h-[44px] px-4 font-label-md text-label-md text-secondary hover:text-primary" href="/agenda">
              <span class="material-symbols-outlined text-[18px]">arrow_back</span>
              Retour à l'agenda
            </a>
          </div>
        </aside>
      </div>

      <h2 class="mt-14 font-headline-md text-headline-md text-primary">À lire aussi</h2>
      <ul class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4 p-0 list-none">
        {autres.map((autre) => (
          <li>
            <a class="flex flex-col h-full rounded-lg bg-surface-container-lowest p-5 hover:shadow-md transition-shadow" href={`/agenda/${autre.id}`}>
              <span class="font-label-sm text-label-sm text-secondary">{autre.category}</span>
              <span class="mt-2 font-headline-sm text-headline-sm text-primary">{autre.title}</span>
              <span class="mt-2 font-body-sm text-body-sm text-secondary">{autre.dateLabel}</span>
              <span class="mt-4 inline-flex items-center gap-1 font-label-md text-label-md font-semibold text-primary-container">
                Lire
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Base>
