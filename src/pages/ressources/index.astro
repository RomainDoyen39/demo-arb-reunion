---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Base title="Centre de ressources — ARB Réunion">
  <Header current="ressources" />
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]"><div class="flex flex-col w-full">
<!-- =========================================================================
       1. HERO & MOTEUR DOCUMENTAIRE
       ========================================================================= -->
<section class="page-hero hero-photo relative w-full pt-6 pb-28 md:pb-36 overflow-hidden" style="--hero-image: url('/images/bandeaux/littoral.webp')">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin relative z-10">
<!-- Fil d'Ariane -->
<nav aria-label="Fil d'Ariane" class="flex items-center gap-space-xs text-on-surface-variant font-label-md text-label-md mb-8">
<a class="hover:text-primary-container transition-colors flex items-center gap-1" data-path="accueil" href="/">
<span class="material-symbols-outlined text-[16px]">home</span>
          Accueil
        </a>
<span class="text-outline-variant">/</span>
<a class="hover:text-primary-container transition-colors" data-path="ressources" href="/ressources">Ressources &amp; Savoirs</a>
<span class="text-outline-variant">/</span>
<span aria-current="page" class="text-primary font-semibold">Centre de ressources &amp; Publications</span>
</nav>
<!-- Surtitre & Titre & Pitch -->
<div class="max-w-4xl">
<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-secondary-container text-primary-container font-label-sm text-label-sm uppercase tracking-wider mb-4 shadow-sm">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          MÉDIATHÈQUE SCIENTIFIQUE &amp; TECHNIQUE PÉI
        </div>
<h1 class="font-display-lg text-display-lg text-primary tracking-tight font-extrabold mb-6 leading-tight">
          Centre de ressources &amp; Publications scientifiques
        </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl leading-relaxed mb-10">
          Explorez, consultez et téléchargez plus de <strong>1 200 rapports scientifiques</strong>, guides techniques, synthèses d'observation, atlas naturalistes et jeux de données validés par le <strong class="text-on-surface">Conseil Scientifique Régional du Patrimoine Naturel (CSRPN)</strong> et le réseau d'experts de l'île de La Réunion.
    </p>
  </div>
<!-- Moteur de Recherche Avancé -->
<div class="w-full bg-surface-container-lowest rounded-xl shadow-[0_20px_50px_rgba(17,78,74,0.06)] p-6 md:p-8 mb-12">
<form class="flex flex-col gap-6" id="ressources-search">
<!-- Barre de saisie plein texte -->
<div class="relative w-full">
<span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-primary-container text-[24px]">search</span>
<input class="w-full pl-14 pr-32 py-4 rounded-full bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-4 focus:ring-secondary-container/50 focus:outline-none transition-all placeholder:text-on-surface-variant/50" id="search-input" placeholder="Rechercher un rapport, un auteur, une espèce, un taxon (ex: Pétrel de Barau, ravines, trame noire, EEE)..." type="search">
<div class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center">
<button class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 text-xs text-on-surface-variant hover:text-primary transition-colors bg-surface-container rounded-full" id="search-clear" type="button">
<span class="material-symbols-outlined text-[14px]">close</span>
                Effacer
              </button>
</div>
</div>
<!-- Filtres multi-critères & Bouton CTA -->
<div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
<!-- Type de document -->
<div class="md:col-span-4 relative">
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-1 ml-2" for="filter-type">Type de document</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-secondary text-[20px] pointer-events-none">auto_stories</span>
<select class="w-full pl-11 pr-10 py-3 rounded-full bg-surface-container-low text-on-surface font-label-lg text-label-lg appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary-container transition-all" id="filter-type">
<option value="all">Tous les types de documents</option>
<option value="rapport">Rapports scientifiques</option>
<option value="guide">Guides méthodologiques</option>
<option value="atlas">Atlas &amp; Cartes thématiques</option>
<option value="droit">Textes &amp; Avis juridiques CSRPN</option>
<option value="espece">Fiches d'espèces &amp; protocoles</option>
</select>
<span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 text-secondary text-[20px] pointer-events-none">expand_more</span>
</div>
</div>
<!-- Thématique -->
<div class="md:col-span-5 relative">
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-1 ml-2" for="filter-theme">Thématique prioritaire</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-secondary text-[20px] pointer-events-none">filter_vintage</span>
<select class="w-full pl-11 pr-10 py-3 rounded-full bg-surface-container-low text-on-surface font-label-lg text-label-lg appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary-container transition-all" id="filter-theme">
<option value="all">Toutes les thématiques</option>
<option value="marine">Milieux marins &amp; récifs coralliens</option>
<option value="foret">Forêts indigènes &amp; flore des Hauts</option>
<option value="invasives">Espèces Exotiques Envahissantes (EEE)</option>
<option value="trames">Trames Verte, Bleue, Noire &amp; Aménagement</option>
<option value="especes-menacees">Faune endémique &amp; plans de sauvegarde</option>
        </select>
<span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 text-secondary text-[20px] pointer-events-none">expand_more</span>
</div>
</div>
<!-- Bouton d'action -->
<div class="md:col-span-3 self-end">
<button class="box-border h-[44px] w-full inline-flex items-center justify-center gap-2 px-6 rounded-full bg-primary-container text-inverse-on-surface font-label-lg text-label-lg hover:bg-primary shadow-[0_4px_16px_rgba(17,78,74,0.18)] hover:shadow-lg transition-all active:scale-[0.99]" type="submit">
<span class="material-symbols-outlined text-[20px]">filter_list</span>
<span>Filtrer les ressources</span>
</button>
</div>
</div>
<!-- Tags rapides suggérés -->
<div class="flex items-center flex-wrap gap-2 pt-2 text-on-surface-variant font-label-sm text-label-sm">
<span class="font-medium text-secondary">Mots-clés fréquents :</span>
<button class="px-2.5 py-1 rounded-full bg-surface-container hover:bg-secondary-container text-on-surface transition-colors" data-query="Pétrel de Barau" type="button">Pétrel de Barau</button>
<button class="px-2.5 py-1 rounded-full bg-surface-container hover:bg-secondary-container text-on-surface transition-colors" data-query="récif" type="button">Récifs coralliens</button>
<button class="px-2.5 py-1 rounded-full bg-surface-container hover:bg-secondary-container text-on-surface transition-colors" data-query="Trame Noire" type="button">Pollution lumineuse</button>
<button class="px-2.5 py-1 rounded-full bg-surface-container hover:bg-secondary-container text-on-surface transition-colors" data-query="envahissantes" type="button">Plantes envahissantes</button>
<button class="px-2.5 py-1 rounded-full bg-surface-container hover:bg-secondary-container text-on-surface transition-colors" data-query="semi-sèche" type="button">Forêt semi-sèche</button>
</div>
</form>
</div>
<!-- Compteurs Statistiques Clés -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
<div class="p-6 rounded-lg bg-surface-container-low flex flex-col justify-center">
<div class="flex items-center gap-2 text-primary font-headline-lg text-headline-lg font-bold tracking-tight">
<span>1 240+</span>
</div>
<span class="font-label-md text-label-md text-secondary mt-1 font-medium">Documents répertoriés</span>
<span class="font-body-sm text-body-sm text-on-surface-variant/80 mt-0.5">Mis à jour chaque semaine</span>
</div>
<div class="p-6 rounded-lg bg-surface-container-low flex flex-col justify-center">
<div class="flex items-center gap-2 text-primary-container font-headline-lg text-headline-lg font-bold tracking-tight">
<span>100%</span>
<span class="material-symbols-outlined text-[24px] text-primary">lock_open_right</span>
</div>
<span class="font-label-md text-label-md text-secondary mt-1 font-medium">Accès libre (Open Access)</span>
<span class="font-body-sm text-body-sm text-on-surface-variant/80 mt-0.5">Licences Etalab 2.0 &amp; CC</span>
</div>
<div class="p-6 rounded-lg bg-surface-container-low flex flex-col justify-center">
<div class="flex items-center gap-2 text-primary font-headline-lg text-headline-lg font-bold tracking-tight">
<span>45</span>
</div>
<span class="font-label-md text-label-md text-secondary mt-1 font-medium">Partenaires contributeurs</span>
<span class="font-body-sm text-body-sm text-on-surface-variant/80 mt-0.5">Laboratoires, ONG, DEAL, ONF</span>
</div>
<div class="p-6 rounded-lg bg-surface-container-low flex flex-col justify-center">
<div class="flex items-center gap-2 text-tertiary-container font-headline-lg text-headline-lg font-bold tracking-tight">
<span>18 500</span>
</div>
<span class="font-label-md text-label-md text-secondary mt-1 font-medium">Téléchargements en 2024</span>
<span class="font-body-sm text-body-sm text-on-surface-variant/80 mt-0.5">Rayonnement océan Indien</span>
</div>
</div>
</div>
<div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none">
<svg class="block h-12 w-full fill-current text-surface-container md:h-20" preserveAspectRatio="none" viewBox="0 -16 1440 112">
<path d="M0,32 C280,96 520,0 840,48 C1160,96 1360,16 1440,32 L1440,96 L0,96 Z"></path>
</svg>
</div>
</section>
<!-- =========================================================================
       2. PUBLICATIONS SCIENTIFIQUES MAJEURES À LA UNE (FOCUS ÉDITIONS RÉCENTES)
       ========================================================================= -->
<section class="relative -mt-px w-full overflow-hidden bg-surface-container pt-12 pb-24 md:pt-20 md:pb-32">
<div class="w-full max-w-[1380px] mx-auto px-gutter-mobile md:px-gutter lg:px-margin">
<!-- En-tête de section avec texture éditoriale -->
<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
<div>
<div class="flex items-center gap-2 font-label-sm text-label-sm uppercase tracking-widest text-tertiary-container mb-2 font-bold">
<span class="w-2.5 h-0.5 bg-tertiary-container"></span>
            FOCUS ÉDITIONS RÉCENTES
          </div>
<h2 class="font-headline-lg text-headline-lg text-on-surface font-bold tracking-tight">
            Publications scientifiques majeures
          </h2>
</div>
<p class="font-body-md text-body-md text-on-surface-variant max-w-md">
          Travaux institutionnels de référence co-édités par l'ARB Réunion, le Conseil Scientifique Régional et les instituts de recherche.
        </p>
</div>
<div id="featured-docs">
<!-- Grande mise en avant d'un document maître (Bento Featured) -->
<div data-doc data-featured data-type="rapport" data-theme="foret marine especes-menacees" data-date="2024-11-01" data-downloads="2400" data-title="Bilan décennal de l'État de la Biodiversité Réunionnaise" data-org="ARB Réunion" data-cite="ARB Réunion, DEAL Réunion, CBNM Mascarin et CSRPN (2024). Bilan décennal de la Biodiversité Réunionnaise. DOI: 10.3406/arbr.2024.01" class="w-full bg-surface-container-lowest rounded-xl shadow-[0_16px_40px_rgba(17,78,74,0.07)] p-8 md:p-12 mb-10 overflow-hidden relative">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
<!-- Image de couverture stylisée -->
<div class="lg:col-span-4 relative group">
<div class="relative w-full aspect-[3/4] rounded-lg overflow-hidden shadow-2xl bg-primary-container">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" data-alt="Élégante couverture de rapport scientifique institutionnel intitulé Bilan Décennal de la Biodiversité Réunionnaise 2015-2025 avec des illustrations botaniques de fougères endémiques, vues aériennes des cirques verdoyants de La Réunion, cartographies d'habitats et typographie dorée soignée sur fond vert lagon profond." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCs_EnMxwj9PzJfmSwXSdBW_zq2nhOuNjl672QXhX15uTu5jvUnd8Gy1BloegWS8yXEsxv54gpfoPuYUleUcGJWEXo-zHa_mGRpYYW0eM6esvRsyMeR5D6Mt1PlT-FB0d-GFrGQbx3CNtuDMaNgSyF0hMpidjOW6sWz6nydfiDvMtf3WZ60l9fmMDA86MmEMRRLw-nlUUu1SLvYS2Y056QuAGuP5pmXLaONu_CueZPZ">
<div class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/20 to-transparent flex flex-col justify-end p-6 text-inverse-on-surface">
<span class="px-2.5 py-1 rounded bg-tertiary-container text-tertiary-fixed font-label-sm text-label-sm uppercase tracking-wider self-start mb-2 font-bold">
                  Document Maître
                </span>
<span class="font-headline-sm text-headline-sm font-semibold leading-tight text-white">
                  Édition officielle 2024
                </span>
</div>
</div>
<!-- Effet de papier superposé arrière -->
<div class="absolute -right-3 -bottom-3 w-full h-full rounded-lg bg-secondary-container/40 -z-10 transform rotate-1 hidden sm:block"></div>
</div>
<!-- Contenu et métadonnées du document maître -->
<div class="lg:col-span-8 flex flex-col">
<div class="flex flex-wrap items-center gap-2 mb-3">
<span class="px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-label-sm text-label-sm font-semibold">
                Rapport de référence régionale
              </span>
<span class="text-on-surface-variant font-label-sm text-label-sm">• Parution Novembre 2024</span>
<span class="text-on-surface-variant font-label-sm text-label-sm">• DOI: 10.3406/arbr.2024.01</span>
</div>
<h3 class="font-display-lg-mobile md:font-headline-lg md:text-headline-lg text-primary font-bold tracking-tight mb-4">
              Bilan décennal de l'État de la Biodiversité Réunionnaise (2015-2025)
            </h3>
<div class="flex items-center gap-3 text-secondary font-label-md text-label-md mb-6">
<span class="flex items-center gap-1">
<span class="material-symbols-outlined text-[18px]">domain</span>
                ARB Réunion / DEAL Réunion / CBNM Mascarin / CSRPN
              </span>
</div>
<p class="font-body-lg text-body-lg text-on-surface-variant mb-6 leading-relaxed">
              Fruit de cinq années de collecte de données standardisées, ce bilan constitue la synthèse la plus exhaustive jamais réalisée sur l'état de conservation des 10 000 espèces recensées à La Réunion. Il analyse l'évolution des pressions anthropiques, l'efficacité des aires protégées dans les cirques et les récifs, ainsi que les perspectives d'adaptation face aux dérèglements climatiques insulaires.
            </p>
<!-- Spécifications techniques -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 rounded-lg bg-surface-container-low mb-8">
<div>
<span class="block font-label-sm text-label-sm text-secondary">Volume</span>
<span class="font-label-lg text-label-lg text-on-surface font-bold">142 pages</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-secondary">Format &amp; Poids</span>
<span class="font-label-lg text-label-lg text-on-surface font-bold">PDF (24.3 Mo)</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-secondary">Données brutes</span>
<span class="font-label-lg text-label-lg text-on-surface font-bold">Incluses (GeoJSON)</span>
</div>
<div>
<span class="block font-label-sm text-label-sm text-secondary">Licence</span>
<span class="font-label-lg text-label-lg text-on-surface font-bold">CC-BY 4.0</span>
</div>
</div>
<!-- Boutons de téléchargement et d'action -->
<div class="flex flex-wrap items-center gap-4">
<a class="js-download inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full bg-primary-container text-inverse-on-surface hover:bg-primary font-label-lg text-label-lg shadow-[0_4px_16px_rgba(17,78,74,0.2)] transition-all" href="#catalogue">
<span class="material-symbols-outlined text-[20px]">download</span>
<span>Télécharger le rapport intégral (PDF - 24 Mo)</span>
</a>
<a class="js-download inline-flex items-center gap-2 px-5 py-3 rounded-full bg-secondary-container text-on-secondary-container hover:bg-primary-fixed transition-colors font-label-lg text-label-lg" href="#catalogue">
<span class="material-symbols-outlined text-[18px]">menu_book</span>
<span>Feuilleter la synthèse (12p)</span>
</a>
<button class="js-cite inline-flex items-center gap-1.5 px-4 py-3 rounded-full text-secondary hover:text-primary hover:bg-surface-container transition-colors font-label-md text-label-md" title="Copier la citation académique" type="button">
<span class="material-symbols-outlined text-[18px]">format_quote</span>
<span>Citer ce document</span>
</button>
</div>
</div>
</div>
</div>
<!-- Deux autres parutions majeures (Grille 2 colonnes) -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
<!-- Carte Parution 1 : Atlas Trame Noire -->
<article data-doc data-featured data-type="atlas" data-theme="trames" data-date="2024-10-01" data-downloads="1600" data-title="Atlas cartographique de la Trame Noire" data-org="ARB Réunion & SEOR" data-cite="ARB Réunion et SEOR (2024). Atlas cartographique de la Trame Noire et corridors nocturnes de La Réunion." class="bg-surface-container-lowest rounded-xl shadow-[0_10px_30px_rgba(17,78,74,0.04)] p-6 md:p-8 flex flex-col justify-between group">
<div>
<div class="relative w-full h-52 rounded-lg overflow-hidden mb-6 bg-surface-dim">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" data-alt="Carte satellite nocturne de La Réunion montrant l'obscurité préservée des pitons et cirques contrastant avec la lumière urbaine du littoral, mise en valeur cartographique des couloirs de vol des oiseaux marins pétrels protégés." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCzRx7ssy_Ty50Y_OZeHcOzqxWCHJuoOyen3m5E-xLKJz6MKb6oINECEc_J6A6FJmgGVkI3qhM2y_bu1VjrMuL_h-i85A2_ufpHShnDtppw03SPYifWLQE0fEPmuI_DdDLk-5ToR2rAzjtxhRZXGiojWx9ZTgjS2Mx9kFtDP8eTiabxqMiCVr4h2m6-kkCo8d2m-b77U-89xrATFHDQ27RRzrli9gPYiA5DsFzYbIM_">
<span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-primary-container text-inverse-on-surface font-label-sm text-label-sm font-semibold">
                Atlas &amp; Cartographie
              </span>
</div>
<div class="flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm mb-2">
<span>ARB Réunion &amp; SEOR</span>
<span>•</span>
<span>Octobre 2024</span>
</div>
<h4 class="font-headline-sm text-headline-sm text-primary font-bold mb-3 leading-snug">
              Atlas cartographique de la Trame Noire et corridors nocturnes de La Réunion
            </h4>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3 leading-relaxed">
              Cartographie haute résolution de la pollution lumineuse sur l'île et modélisation des couloirs d'envol des jeunes Pétrels de Barau et Pétrels noirs de Bourbon. Ce recueil fournit les préconisations techniques destinées aux 24 communes pour la rénovation de leur éclairage public.
            </p>
</div>
<div class="pt-4 border-t-0 flex items-center justify-between">
<span class="font-label-md text-label-md text-secondary font-medium flex items-center gap-1.5">
<span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
              88 pages • PDF 16 Mo
            </span>
<a class="js-download inline-flex items-center gap-1 text-primary-container font-label-lg text-label-lg font-bold group-hover:translate-x-1 transition-transform" href="#catalogue">
              Télécharger
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</div>
</article>
<!-- Carte Parution 2 : Guide Biosécurité EEE -->
<article data-doc data-featured data-type="guide" data-theme="invasives" data-date="2024-09-01" data-downloads="1100" data-title="Guide pratique de lutte et biosécurité contre les Espèces Exotiques Envahissantes végétales" data-org="GEIR / CIRAD / Parc National" data-cite="GEIR, CIRAD et Parc national de La Réunion (2024). Guide pratique de lutte et biosécurité contre les Espèces Exotiques Envahissantes végétales." class="bg-surface-container-lowest rounded-xl shadow-[0_10px_30px_rgba(17,78,74,0.04)] p-6 md:p-8 flex flex-col justify-between group">
<div>
<div class="relative w-full h-52 rounded-lg overflow-hidden mb-6 bg-surface-dim">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" data-alt="Forestier et botaniste inspectant de près un sous-bois dense dans les hauts de La Réunion avec des goyaviers et fougères arborescentes, matériel de biosécurité sur le terrain pour préserver la forêt primitive des espèces exotiques envahissantes." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDQqYJ4A-tOcDmf5Tn2xGdsZysCXkIJ_ZJX2-625feCQd1RSGjE54KRspwyeQ25N5ZWTVJu_8Tgm5dKywE2apMvxOydgGH1bHTi5wHgVSfTQG7flvidgtIsojmPyV-IkzgJGFIRrvhw_U4vQktRqqFbEXY30Tg0vQwoGTWUVqZLtcS9Z3jAhHRW_GjpKrWezXuxaOOgz8iXwSkBPkxKykeZSAezRNZW8o5UcbBgLjiq">
<span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-tertiary-container text-tertiary-fixed font-label-sm text-label-sm font-semibold">
                Guide Méthodologique
              </span>
</div>
<div class="flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm mb-2">
<span>GEIR / CIRAD / Parc National</span>
<span>•</span>
<span>Septembre 2024</span>
</div>
<h4 class="font-headline-sm text-headline-sm text-primary font-bold mb-3 leading-snug">
              Guide pratique de lutte et biosécurité contre les Espèces Exotiques Envahissantes végétales
            </h4>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3 leading-relaxed">
              Protocoles de désinfection des engins de chantier, méthodes manuelles d'arrachage et stratégies de revégétalisation après chantiers d'éradication du Goyavier de Chine, du Raisin marron et de la Liane papillon dans les forêts de moyenne et haute altitude.
